{
  "$schema": "https://opencode.ai/config.json",
  "watcher": {
    "ignore": [
      ".git/**",
      "**/bin/**",
      "**/obj/**",
      ".vs/**",
      "**/packages/**",
      "**/TestResults/**",
      "**/artifacts/**",
      "**/publish/**"
    ]
  },
  "plugin": ["opencode-snippets", "cc-safety-net"],
  "formatter": {
    "dotnet-format": {
      "command": ["dotnet", "format", "--include", "$FILE"],
      "extensions": [".cs", ".razor"]
    },
    "prettier": {
      "command": ["prettier", "--write", "$FILE"],
      "extensions": [".scss", ".css", ".json", ".md", ".yml", ".yaml"]
    }
  },
  "mcp": {
    "brave-search": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "BRAVE_API_KEY",
        "-e",
        "BRAVE_MCP_TRANSPORT",
        "mcp/brave-search"
      ],
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}",
        "BRAVE_MCP_TRANSPORT": "stdio"
      },
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "sequentialthinking": {
      "type": "local",
      "command": ["docker", "run", "-i", "--rm", "mcp/sequentialthinking"],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "chrome-devtools-mcp",
        "--executablePath",
        "C:\\Program Files\\BraveSoftware\\Brave-Browser\\Application\\brave.exe"
      ]
    }
  },
  "tools": {
    "brave-search_brave_*": false,
    "brave-search_brave_web_search": true
  }
}
