{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-snippets"],
  "formatter": {
    "dotnet-format": {
      "command": ["dotnet", "format", "--include", "$FILE"],
      "extensions": [".cs"]
    }
  },
  "mcp": {
    "brave-search": {
      "type": "local",
      "command": ["docker", "run", "-i", "--rm", "-e", "BRAVE_API_KEY", "-e", "BRAVE_MCP_TRANSPORT", "mcp/brave-search"],
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}",
        "BRAVE_MCP_TRANSPORT": "stdio"
      },
      "enabled": true
    }
  },
  "tools": {
    "brave-search_brave_*": false,
    "brave-search_brave_web_search": true
  }
}