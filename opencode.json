{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-snippets"],
  "formatter": {
    "dotnet-format": {
      "command": ["dotnet", "format", "--include", "$FILE"],
      "extensions": [".cs"]
    }
  },
  "mcp": {
    "brave-search": {
      "type": "local",
      "command": ["docker", "run", "-i", "--rm", "-e", "BRAVE_API_KEY", "mcp/brave-search"],
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      },
      "enabled": true
    }
  }
}