{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "dotnet.defaultSolution": "redmuffin.Blazor.StaticWeb.sln",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": { "source.fixAll": true },
    "files.trimTrailingWhitespace": true,
    "omnisharp.enableRoslynAnalyzers": true,
    "omnisharp.enableEditorConfigSupport": true,
    "blazorwasm.trace": "verbose",
    "azureFunctions.projectSubpath": "src\\redmuffin.Blazor.StaticWeb.Api",
    "azureFunctions.deploySubpath": "src\\redmuffin.Blazor.StaticWeb.Api/bin/Release/net8.0/publish",
    "azureFunctions.projectLanguage": "C#",
    "azureFunctions.projectRuntime": "~4",
    "debug.internalConsoleOptions": "neverOpen",
    "azureFunctions.preDeployTask": "publish (functions)"
  },
  "extensions": {
    "recommendations": [
      "ms-azuretools.vscode-azurefunctions",
      "ms-dotnettools.csharp",
      "ms-dotnettools.blazorwasm-companion",
      "ms-azuretools.vscode-azurestaticwebapps",
      "ms-dotnettools.csdevkit",
      "editorconfig.editorconfig",
      "streetsidesoftware.code-spell-checker",
      "formulahendry.dotnet-test-explorer"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Launch and Debug Standalone Blazor WebAssembly App",
        "type": "blazorwasm",
        "request": "launch",
        "cwd": "${workspaceFolder}/src/redmuffin.Blazor.StaticWeb"
      },
      {
        "name": "Attach to .NET Functions",
        "type": "coreclr",
        "request": "attach",
        "processId": "${command:azureFunctions.pickProcess}"
      },
      {
        "name": "Debug Functions (.NET Isolated)",
        "type": "coreclr",
        "request": "launch",
        "program": "${workspaceFolder}/src/redmuffin.Blazor.StaticWeb.Api/bin/Debug/net8.0/redmuffin.Blazor.StaticWeb.Api.dll",
        "args": [],
        "cwd": "${workspaceFolder}/src/redmuffin.Blazor.StaticWeb.Api",
        "stopAtEntry": false,
        "console": "internalConsole"
      }
    ],
    "compounds": [
      {
        "name": "Blazor WebAssembly + Functions API",
        "configurations": ["Launch and Debug Standalone Blazor WebAssembly App", "Debug Functions (.NET Isolated)"]
      }
    ]
  }
}