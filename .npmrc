# ================================================
# Supply-Chain Attack Protection (2026 npm Best Practice)
# ================================================
min-release-age=1                  # npm: 1 day (npm uses DAYS — balance of safety vs velocity)
minimum-release-age=1440           # pnpm: 1440 minutes = 1 day (pnpm uses MINUTES)
# npm  key: min-release-age | unit: DAYS   | 1 day = 1
# pnpm key: minimum-release-age  | unit: MINUTES | 1 day = 1440

# ================================================
# Hardened Defaults — explicit beats implicit for supply chain defense.
# A compromised global .npmrc can override npm defaults. These are explicit.
# ================================================
registry=https://registry.npmjs.org/
audit=true
audit-level=moderate
package-lock=true
fund=false
fetch-timeout=60000
fetch-retries=3
ignore-scripts=true
save-exact=true
strict-peer-deps=true
engine-strict=true
