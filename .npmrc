# ================================================
# Supply-Chain Attack Protection (2026 npm Best Practice)
# ================================================
min-release-age=7                  # 7 days (npm uses DAYS — official recommendation post-Axios incident)

# ================================================
# Hardened Defaults (Aligned with Your .NET Standards)
# ================================================
ignore-scripts=true                # Prevent malicious postinstall scripts
save-exact=true                    # Enforce exact versions (mirrors ManagePackageVersionsCentrally)
strict-peer-deps=true
engine-strict=true
