# ================================================
# Supply-Chain Attack Protection (2026 npm Best Practice)
# ================================================
# Package managers use different keys and units for minimum release age.
# Both npm AND pnpm keys are set because they don't collide and a
# compromised global config could use either manager to bypass.
min-release-age=1                  # npm: 1 day. Compromise: blocks typosquatted
                                   #   packages while allowing same-day security
                                   #   patches. User-level .npmrc uses 2 days.
minimum-release-age=1440           # pnpm: 1440 minutes = 1 day

# ================================================
# Hardened Defaults — explicit beats implicit for supply chain defense.
# ================================================
# A compromised global .npmrc can override npm's built-in defaults.
# Every setting here is explicitly declared so the project config
# takes precedence regardless of the user's environment.

registry=https://registry.npmjs.org/        # Prevent dependency confusion via
                                             #   malicious registry redirect.
audit=true                                   # Enforce vulnerability scanning.
audit-level=moderate                         # Moderate+ severity only. Avoids
                                             #   noise from low-severity findings
                                             #   while catching exploitable vulns.
package-lock=true                            # Lock dependency tree — prevents
                                             #   drift and ensures reproducible
                                             #   installs across environments.
fund=false                                   # Suppress funding messages after
                                             #   install — not a security setting,
                                             #   just noise reduction.
fetch-timeout=60000                          # 60s timeout. Default is 300000 (5m)
                                             #   which allows slow attacks. Fail
                                             #   fast on compromised registries.
fetch-retries=3                              # Explicitly match npm default.
                                             #   Prevents global config from
                                             #   silently raising retry count.

ignore-scripts=true                          # CRITICAL: blocks arbitrary code
                                             #   execution from postinstall hooks.
                                             #   Never remove without discussion.
save-exact=true                              # Pin exact versions — prevents
                                             #   semver range attacks.
strict-peer-deps=true                        # Fail on peer dependency conflicts
                                             #   rather than silently installing
                                             #   incompatible versions.
engine-strict=true                           # Reject packages whose engines
                                             #   field doesn't match current
                                             #   Node.js version.
