<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ConfigureAwaitFixer</AssemblyName>
    <RootNamespace>redmuffin.Tools.ConfigureAwaitFixer</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>redmuffin.Tools.ConfigureAwaitFixer</PackageId>
    <Version>1.0.2</Version>
    <DevelopmentDependency>true</DevelopmentDependency>
    <!-- slopwatch-ignore: SW005 [NuGet packaging warning for development-dependency analyzer packages; nuspec structure inherently triggers NU5128] -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsConfigureAwaitFixerProject>true</IsConfigureAwaitFixerProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" PrivateAssets="none"
                      GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- Bundle analyzer DLLs and BuildHost into output and publish directories -->
  <Target Name="CopyAnalyzerDll" AfterTargets="Build">
    <!-- Guard: GeneratePathProperty must have resolved -->
    <Error Text="PkgMicrosoft_CodeAnalysis_NetAnalyzers is not set. Verify the PackageReference resolves and dotnet restore has run."
           Condition="'$(PkgMicrosoft_CodeAnalysis_NetAnalyzers)' == ''" />

    <!-- Ensure publish directory exists for dotnet pack -->
    <MakeDir Directories="$(ProjectDir)publish" />

    <!-- Analyzer DLLs: copy from NuGet cache to build output (for runtime Assembly.LoadFrom) -->
    <Copy SourceFiles="$(PkgMicrosoft_CodeAnalysis_NetAnalyzers)\analyzers\dotnet\Microsoft.CodeAnalysis.NetAnalyzers.dll"
          DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(PkgMicrosoft_CodeAnalysis_NetAnalyzers)\analyzers\dotnet\cs\Microsoft.CodeAnalysis.CSharp.NetAnalyzers.dll"
          DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />

    <!-- Analyzer DLLs: copy from output to publish (for NuGet packaging) -->
    <Copy SourceFiles="$(OutputPath)Microsoft.CodeAnalysis.NetAnalyzers.dll;$(OutputPath)Microsoft.CodeAnalysis.CSharp.NetAnalyzers.dll"
          DestinationFolder="$(ProjectDir)publish" SkipUnchangedFiles="true" />

    <!-- BuildHost: populated by contentFiles from Workspaces.MSBuild package. Copy to publish. -->
    <ItemGroup>
      <_BuildHostNetCore Include="$(OutputPath)BuildHost-netcore\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_BuildHostNetCore)"
          DestinationFiles="@(_BuildHostNetCore->'$(ProjectDir)publish\BuildHost-netcore\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="@(_BuildHostNetCore->Count()) &gt; 0" />

    <!-- Fixer output: copy all DLLs, EXEs, and JSON files from output root to publish -->
    <ItemGroup>
      <_FixerOutput Include="$(OutputPath)*.dll;$(OutputPath)*.exe;$(OutputPath)*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_FixerOutput)"
          DestinationFolder="$(ProjectDir)publish" SkipUnchangedFiles="true" />
  </Target>

  <!-- README (packed as PackageReadmeFile) -->
  <ItemGroup>
    <None Include="README.md"
          Pack="true"
          PackagePath="\"
          Visible="false" />
  </ItemGroup>

  <!-- Pre-built publish output, committed to repo -->
  <ItemGroup>
    <None Include="publish/*"
          Pack="true"
          PackagePath="tools/net10.0/any"
          Visible="false" />
    <None Include="publish/BuildHost-netcore/*"
          Pack="true"
          PackagePath="tools/net10.0/any/BuildHost-netcore"
          Visible="false" />
  </ItemGroup>

</Project>
