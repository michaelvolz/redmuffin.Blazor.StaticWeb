<Project>

  <!-- Inherit analyzers and shared properties from root -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Tools use non-locked restore for simpler package management -->
    <RestoreLockedMode>false</RestoreLockedMode>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <!-- Disable warnings-as-errors during dotnet watch. See root Directory.Build.props for rationale. -->
    <TreatWarningsAsErrors Condition="'$(DotNetWatchBuild)' != 'true'">true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
