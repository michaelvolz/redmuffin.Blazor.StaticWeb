<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="local-tools" value="./nupkgs/" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local-tools">
      <package pattern="redmuffin.Tools.QualityGates" />
    </packageSource>
  </packageSourceMapping>

  <config>
    <add key="signatureValidationMode" value="accept" />
  </config>
</configuration>
