{
  "dotnet.solution.autoOpen": "YourSolutionName.sln",
  "dotnet.defaultSolution": "redmuffin.Blazor.StaticWeb.sln",
  "dotnet.debugger.launchJsonSchemaVersion": "1.0.0",
  "dotnet.server.waitForDebugger": false,
  "dotnet.tests.useUtmps": true,
  "azureFunctions.projectSubpath": "src/redmuffin.Blazor.StaticWeb.Api",
  "azureFunctions.deploySubpath": "src/redmuffin.Blazor.StaticWeb.Api/bin/Release/net9.0/publish",
  "azureFunctions.projectLanguage": "C#",
  "azureFunctions.projectRuntime": "~4",
  "azureFunctions.preDeployTask": "publish (functions)",
  "debug.internalConsoleOptions": "neverOpen",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit"
  },
  "files.trimTrailingWhitespace": true,
  "blazorwasm.trace": "verbose",
  "remote.containers.dockerPath": "docker",
  "remote.containers.dockerComposePath": "docker-compose",
  "remote.containers.autoForwardPorts": true,
  "remote.containers.copyGitCredentials": true,
  "remote.containers.useDockerSdkFromHost": false,
  "security.workspace.trust.enabled": true,
  "security.workspace.trust.startupPrompt": "never",
  "workbench.colorTheme": "Cobalt2",
  "workbench.colorCustomizations": {
    "sideBar.background": "#122738",
    "sideBar.foreground": "#aaaaaa",
    "sideBar.border": "#0d3a58",
    "sideBarSectionHeader.background": "#193549",
    "sideBarSectionHeader.foreground": "#aaaaaa",
    "sideBarSectionHeader.border": "#0d3a58",
    "sideBarTitle.foreground": "#aaaaaa",
    "activityBar.background": "#122738",
    "activityBar.foreground": "#ffffff",
    "activityBarBadge.background": "#ffc600",
    "activityBarBadge.foreground": "#000000",
    "list.activeSelectionBackground": "#193549",
    "list.activeSelectionForeground": "#ffffff",
    "list.hoverBackground": "#193549",
    "list.hoverForeground": "#ffffff",
    "list.inactiveSelectionBackground": "#0d3a58",
    "list.focusBackground": "#0d3a58",
    "list.focusForeground": "#ffffff",
    "tree.indentGuidesStroke": "#3B536480",
    "editorGroupHeader.tabsBackground": "#122738",
    "tab.activeBackground": "#193549",
    "tab.inactiveBackground": "#122738",
    "tab.activeForeground": "#ffffff",
    "statusBar.background": "#122738",
    "statusBar.foreground": "#aaaaaa"
  }
}
