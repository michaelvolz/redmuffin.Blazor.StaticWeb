{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start-full-stack",
      "dependsOn": ["run swa-launcher"],
      "problemMatcher": ["$msCompile"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "fullstack"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "start-blazor-app",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/src/redmuffin.Blazor.StaticWeb/redmuffin.Blazor.StaticWeb.csproj"
      ],
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": ".",
              "file": 1,
              "location": 2,
              "message": 3
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^.*[Bb]uilding.*",
            "endsPattern": "^.*Now listening on:.*"
          }
        }
      ],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "fullstack"
      }
    },
    {
      "label": "run swa-launcher",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/src/SwaLauncher/SwaLauncher.csproj"
      ],
      "problemMatcher": [
        "$msCompile",
        {
          "pattern": [
            {
              "regexp": ".",
              "file": 1,
              "location": 2,
              "message": 3
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^.*Starting the SWA CLI.*",
            "endsPattern": "^.*Emulator started.*"
          }
        }
      ],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "fullstack"
      },
      "dependsOn": ["start-blazor-app", "func: host start"]
    },
    {
      "label": "run swa cli",
      "command": "swa",
      "type": "shell",
      "args": [
        "start",
        "http://localhost:5233",
        "--api-location",
        "http://localhost:7071/api"
      ],
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "run tests",
      "command": "dotnet",
      "type": "process",
      "args": ["test", "${workspaceFolder}/redmuffin.Blazor.StaticWeb.sln"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/redmuffin.Blazor.StaticWeb.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build (cross-platform)",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/redmuffin.Blazor.StaticWeb.sln"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "${workspaceFolder}/redmuffin.Blazor.StaticWeb.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/redmuffin.Blazor.StaticWeb.sln"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "clean (functions)",
      "command": "dotnet",
      "args": ["clean"],
      "type": "process",
      "problemMatcher": "$msCompile",
      "options": {
        "cwd": "${workspaceFolder}/src/redmuffin.Blazor.StaticWeb.Api"
      }
    },
    {
      "label": "build (functions)",
      "command": "dotnet",
      "type": "process",
      "args": ["build"],
      "dependsOn": "clean (functions)",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile",
      "options": {
        "cwd": "${workspaceFolder}/src/redmuffin.Blazor.StaticWeb.Api"
      }
    },
    {
      "label": "clean release (functions)",
      "command": "dotnet",
      "args": ["clean", "--configuration", "Release"],
      "type": "process",
      "problemMatcher": "$msCompile",
      "options": {
        "cwd": "${workspaceFolder}/src/redmuffin.Blazor.StaticWeb.Api"
      }
    },
    {
      "label": "publish (functions)",
      "command": "dotnet",
      "type": "process",
      "args": ["publish", "--configuration", "Release"],
      "dependsOn": "clean release (functions)",
      "problemMatcher": "$msCompile",
      "options": {
        "cwd": "${workspaceFolder}/src/redmuffin.Blazor.StaticWeb.Api"
      }
    },
    {
      "label": "func: host start",
      "type": "shell",
      "dependsOn": "build (functions)",
      "options": {
        "cwd": "${workspaceFolder}/src/redmuffin.Blazor.StaticWeb.Api/bin/Debug/net9.0"
      },
      "command": "func host start",
      "isBackground": true,
      "problemMatcher": [
        "$msCompile",
        {
          "pattern": [
            {
              "regexp": ".",
              "file": 1,
              "location": 2,
              "message": 3
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^.*Azure Functions Core Tools.*",
            "endsPattern": "^.*Host started.*"
          }
        }
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "fullstack"
      }
    },
    {
      "label": "restore",
      "command": "dotnet",
      "type": "process",
      "args": ["restore"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "restore tools",
      "command": "dotnet",
      "type": "process",
      "args": ["tool", "restore"],
      "problemMatcher": []
    }
  ]
}
