###############################################################################
# Set default behavior to automatically normalize line endings.
# With core.autocrlf=false, .gitattributes controls everything.
# This ensures consistent line endings across Windows, Linux, and Mac.
###############################################################################
* text=auto eol=lf

###############################################################################
# Text files - LF everywhere (Windows, Linux, Mac)
###############################################################################

# Source code
*.cs        text eol=lf
*.razor     text eol=lf
*.razor.cs  text eol=lf

# Web
*.css       text eol=lf
*.scss      text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.html      text eol=lf
*.xml       text eol=lf

# Config
*.yml       text eol=lf
*.yaml      text eol=lf
*.editorconfig text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Documentation
*.md        text eol=lf
*.txt       text eol=lf

# MSBuild - LF (SDK-style projects, works with dotnet CLI and modern VS/Rider)
*.csproj    text eol=lf
*.props     text eol=lf
*.targets   text eol=lf

# PowerShell - LF works cross-platform (PowerShell Core)
*.ps1       text eol=lf
*.psm1      text eol=lf
*.psd1      text eol=lf

# Python
*.py        text eol=lf

###############################################################################
# CRLF files - Windows-only formats that REQUIRE CRLF
###############################################################################

# Solution files - Visual Studio requires CRLF
*.sln       text eol=crlf

# Visual Studio project types that require CRLF (future-proofing)
*.vbproj    text eol=crlf
*.vcxproj   text eol=crlf
*.vcproj    text eol=crlf
*.fsproj    text eol=crlf
*.dbproj    text eol=crlf
*.sqlproj   text eol=crlf
*.wixproj   text eol=crlf
*.lsproj    text eol=crlf
*.modelproj text eol=crlf
*.wwaproj   text eol=crlf
*.xproj     text eol=crlf
*.vcxitems  text eol=crlf
*.filters   text eol=crlf

# Windows batch scripts - cmd.exe requires CRLF or commands may break
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Windows registry files
*.reg       text eol=crlf

# Windows script components
*.ics       text eol=crlf

###############################################################################
# Binary files - must NOT be normalized (line ending conversion corrupts them)
###############################################################################

# Images
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.bmp       binary
*.tif       binary
*.tiff      binary
*.psd       binary
*.ai        binary
*.eps       binary

# SVG - text-based (leave normalized), uncomment next line to treat as binary
*.svg       text
*.svgz      binary

# Fonts
*.ttf       binary
*.eot       binary
*.otf       binary
*.woff      binary
*.woff2     binary

# Archives
*.zip       binary
*.7z        binary
*.gz        binary
*.tar       binary
*.rar       binary
*.jar       binary

# Executables / libraries
*.exe       binary
*.dll       binary
*.so        binary

# Documents
*.pdf       binary

###############################################################################
# NuGet lock files - don't normalize (auto-generated, line endings irrelevant)
###############################################################################
**/packages.lock.json -text

