      "**/.git/hooks/**": "deny",
      "**/.git/config": "deny",
      "~/.local/share/applications/**": "deny"
    },
    "lsp": "allow",
    "bash": {
      "*": "ask",
      "dotnet *": "allow",
      "pwsh *": "allow",
      "powershell *": "allow",
      "git *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "node *": "allow",
      "dir *": "allow",
      "ls *": "allow",
      "grep *": "allow",
