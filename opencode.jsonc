      "**/.git/hooks/**": "deny",
      "**/.git/config": "deny",
      "~/.local/share/applications/**": "deny"
    },
    "external_directory": "ask"
  },
  "formatter": {
    "dotnet-format": {
      "command": ["dotnet", "format", "--include", "$FILE"],
      "extensions": [".cs", ".razor"]
    },
    "prettier": {
      "command": ["prettier", "--write", "$FILE"],
      "extensions": [".scss", ".css", ".json", ".md", ".yml", ".yaml"]
    }
  },
  "mcp": {
    "brave-search": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "BRAVE_API_KEY",
        "mcp/brave-search"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "DISABLE_THOUGHT_LOGGING=true",
        "mcp/sequentialthinking"
      ],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["node", "scripts/mcp/chrome-devtools-launch.mjs"],
      "enabled": true
    },
    "context-mode": {
      "type": "local",
      "command": ["context-mode"],
      "enabled": false
    }
  },
  "tools": {
    "brave-search_brave_*": false,
    "brave-search_brave_web_search": true
  },
  "agent": {
    "rm-uncle-bob-csharp-reviewer": {
      "model": "xai/grok-code-fast-1",
      "mode": "subagent"
    },
    "rm-dotnet-csharp-reviewer": {
      "model": "xai/grok-code-fast-1",
      "mode": "subagent"
    },
