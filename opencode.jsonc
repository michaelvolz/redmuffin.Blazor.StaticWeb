      "~/.local/share/fish/fish_history": "deny",
      "~/Documents/**": "deny",
      "~/OneDrive/Documents/**": "deny",
      "~/Desktop/**": "deny",
      "~/OneDrive/Desktop/**": "deny",
      "~/Pictures/**": "deny",
      "~/OneDrive/Pictures/**": "deny",
      "~/Videos/**": "deny",
      "~/OneDrive/Videos/**": "deny",
      "~/Music/**": "deny",
