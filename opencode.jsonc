      "**/.git/hooks/**": "deny",
      "**/.git/config": "deny",
      "~/.local/share/applications/**": "deny"
    },
    "grep": {
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.config/gnupg/**": "deny",
      "~/.aws/**": "deny",
      "~/.azure/**": "deny",
      "~/.config/gcloud/**": "deny",
      "~/.config/azure/**": "deny",
      "~/.kube/**": "deny",
