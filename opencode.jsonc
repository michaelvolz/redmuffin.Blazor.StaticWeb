      "~/Pictures/**": "deny",
      "~/OneDrive/Pictures/**": "deny",
      "~/Videos/**": "deny",
      "~/OneDrive/Videos/**": "deny",
      "~/Music/**": "deny",
      "~/OneDrive/Music/**": "deny",
      "~/Downloads/**": "deny",
      "~/Favorites/**": "deny",
      "~/Public/**": "deny",
      "~/.config/autostart/**": "deny",
      "~/.config/systemd/user/**": "deny",
      "~/.gitconfig": "deny",
      "~/.config/git/**": "deny",
      "~/.config/Code/User/**": "deny",
      "~/AppData/Roaming/Code/User/**": "deny",
      "**/.vscode/tasks.json": "deny",
      "**/.vscode/settings.json": "deny",
      "**/.vscode/launch.json": "deny",
      "~/AppData/Local/Microsoft/VisualStudio/**": "deny",
      "~/AppData/Roaming/Microsoft/VisualStudio/**": "deny",
      "**/.git/hooks/**": "deny",
      "**/.git/config": "deny",
      "~/.local/share/applications/**": "deny",
      "~/Documents/PowerShell/**": "ask",
      "~/Documents/WindowsPowerShell/**": "ask",
      "~/AppData/Roaming/npm/**": "ask",
      "~/.local/share/pnpm/global/**": "ask",
      "/usr/local/lib/node_modules/**": "ask",
      "~/.config/yarn/global/**": "ask",
      "/etc/**": "ask",
      "~/AppData/Local/Microsoft/WinGet/**": "ask"
    },
    "glob": {
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.config/gnupg/**": "deny",
      "~/.aws/**": "deny",
      "~/.azure/**": "deny",
      "~/.config/gcloud/**": "deny",
      "~/.config/azure/**": "deny",
      "~/.kube/**": "deny",
