<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <PropertyGroup Label="SharedVersions">
    <MicrosoftExtensionsVersion>9.0.16</MicrosoftExtensionsVersion>
    <MicrosoftExtensionsDependencyInjectionAbstractionsVersion>10.0.8</MicrosoftExtensionsDependencyInjectionAbstractionsVersion>
    <TUnitVersion>1.28.7</TUnitVersion>
    <AzureFunctionsWorkerVersion>2.52.0</AzureFunctionsWorkerVersion>
    <AzureFunctionsWorkerApplicationInsightsVersion>2.50.0</AzureFunctionsWorkerApplicationInsightsVersion>
    <AzureFunctionsWorkerExtensionsHttpVersion>3.3.0</AzureFunctionsWorkerExtensionsHttpVersion>
    <AzureFunctionsWorkerExtensionsHttpAspNetCoreVersion>2.1.0</AzureFunctionsWorkerExtensionsHttpAspNetCoreVersion>
    <AzureFunctionsWorkerSdkVersion>2.0.7</AzureFunctionsWorkerSdkVersion>
    <ApplicationInsightsWorkerServiceVersion>2.23.0</ApplicationInsightsWorkerServiceVersion>
    <CoverletVersion>8.0.1</CoverletVersion>
    <BunitVersion>2.7.2</BunitVersion>
    <MicrosoftTestingPlatformVersion>2.1.0</MicrosoftTestingPlatformVersion>
    <AngleSharpVersion>1.4.0</AngleSharpVersion>
    <BlazoredLocalStorageVersion>4.5.0</BlazoredLocalStorageVersion>
    <LZStringCSharpVersion>1.4.0</LZStringCSharpVersion>
    <MarkdigVersion>1.2.0</MarkdigVersion>
    <NewtonsoftJsonVersion>13.0.4</NewtonsoftJsonVersion>
    <MeziantouAnalyzerVersion>3.0.99</MeziantouAnalyzerVersion>
    <VSThreadingAnalyzersVersion>17.14.15</VSThreadingAnalyzersVersion>
    <RoslynatorVersion>4.15.0</RoslynatorVersion>
    <StyleCopAnalyzersVersion>1.2.0-beta.556</StyleCopAnalyzersVersion>
    <AsyncFixerVersion>2.1.0</AsyncFixerVersion>
    <SystemCommandLineVersion>2.0.7</SystemCommandLineVersion>
    <MicrosoftCodeAnalysisVersion>5.3.0</MicrosoftCodeAnalysisVersion>
    <MediatorVersion>3.0.2</MediatorVersion>
  </PropertyGroup>
  <ItemGroup Label="MicrosoftExtensions">
    <PackageVersion Include="coverlet.collector" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftExtensionsDependencyInjectionAbstractionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="YamlDotNet" Version="17.1.0" />
    <PackageVersion Include="Mediator.Abstractions" Version="$(MediatorVersion)" />
    <PackageVersion Include="Mediator.SourceGenerator" Version="$(MediatorVersion)" />
  </ItemGroup>
  <ItemGroup Label="AspNetCore">
    <PackageVersion Include="Microsoft.AspNetCore.Components.Analyzers" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.WebUtilities" Version="$(MicrosoftExtensionsVersion)" />
  </ItemGroup>
  <ItemGroup Label="AzureFunctions">
    <PackageVersion Include="Microsoft.Azure.Functions.Worker" Version="$(AzureFunctionsWorkerVersion)" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.ApplicationInsights" Version="$(AzureFunctionsWorkerApplicationInsightsVersion)" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Core" Version="$(AzureFunctionsWorkerVersion)" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Http" Version="$(AzureFunctionsWorkerExtensionsHttpVersion)" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="$(AzureFunctionsWorkerExtensionsHttpAspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Sdk" Version="$(AzureFunctionsWorkerSdkVersion)" />
    <PackageVersion Include="Microsoft.ApplicationInsights.WorkerService" Version="$(ApplicationInsightsWorkerServiceVersion)" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="TUnit" Version="$(TUnitVersion)" />
    <PackageVersion Include="TUnit.Assertions" Version="$(TUnitVersion)" />
    <PackageVersion Include="bunit" Version="$(BunitVersion)" />
    <PackageVersion Include="coverlet.msbuild" Version="$(CoverletVersion)" />
    <PackageVersion Include="LightMock.Generator" Version="1.2.3" />
    <PackageVersion Include="Microsoft.Testing.Platform" Version="$(MicrosoftTestingPlatformVersion)" />
  </ItemGroup>
  <ItemGroup Label="Other">
    <PackageVersion Include="AngleSharp" Version="$(AngleSharpVersion)" />
    <PackageVersion Include="Blazored.LocalStorage" Version="$(BlazoredLocalStorageVersion)" />
    <PackageVersion Include="BuildWebCompiler2022" Version="$(BuildWebCompiler2022Version)" />
    <PackageVersion Include="LZStringCSharp" Version="$(LZStringCSharpVersion)" />
    <PackageVersion Include="Markdig" Version="$(MarkdigVersion)" />
    <PackageVersion Include="Newtonsoft.Json" Version="$(NewtonsoftJsonVersion)" />
  </ItemGroup>
  <ItemGroup Label="Tools">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="$(MicrosoftCodeAnalysisVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(MicrosoftCodeAnalysisVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.300" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="$(MicrosoftCodeAnalysisVersion)" />
    <PackageVersion Include="redmuffin.Tools.ConfigureAwaitFixer" Version="1.0.2" />
    <PackageVersion Include="System.CommandLine" Version="$(SystemCommandLineVersion)" />
  </ItemGroup>
  <ItemGroup Label="Analyzers">
    <PackageVersion Include="Meziantou.Analyzer" Version="$(MeziantouAnalyzerVersion)" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="$(VSThreadingAnalyzersVersion)" />
    <PackageVersion Include="Roslynator.Analyzers" Version="$(RoslynatorVersion)" />
    <PackageVersion Include="Roslynator.CodeAnalysis.Analyzers" Version="$(RoslynatorVersion)" />
    <PackageVersion Include="Roslynator.Formatting.Analyzers" Version="$(RoslynatorVersion)" />
    <PackageVersion Include="StyleCop.Analyzers" Version="$(StyleCopAnalyzersVersion)" />
    <PackageVersion Include="AsyncFixer" Version="$(AsyncFixerVersion)" />
    <PackageVersion Update="Microsoft.AspNetCore.Components.Analyzers" Version="$(MicrosoftExtensionsVersion)" />
  </ItemGroup>
</Project>