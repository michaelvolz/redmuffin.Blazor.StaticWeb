<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Conditional AoT Compilation: Enable in CI/CD or when explicitly requested -->
    <!-- CI Environments: GitHub Actions, Azure DevOps, Jenkins, etc. -->
    <!-- Manual Override: Set AOT_TESTS=true environment variable to force AoT -->
    <!-- Development Default: AoT disabled for faster local builds (9.4s vs 11.1s) -->
    <RunAOTCompilation Condition="'$(CI)' == 'true' OR '$(GITHUB_ACTIONS)' == 'true' OR '$(AOT_TESTS)' == 'true'">true</RunAOTCompilation>
    <RunAOTCompilation Condition="'$(CI)' != 'true' AND '$(GITHUB_ACTIONS)' != 'true' AND '$(AOT_TESTS)' != 'true'">false</RunAOTCompilation>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- Code Coverage Configuration -->
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>opencover,cobertura,json</CoverletOutputFormat>
    <CoverletOutput>../../coverage/blazor-</CoverletOutput>
    <Include>[redmuffin.Blazor.StaticWeb*]*</Include>
    <Exclude>[*Tests*]*,[*]*Program,[*]*Startup,[System*]*,[Microsoft*]*,[Newtonsoft*]*,[TUnit*]*,[coverlet*]*</Exclude>
    <ExcludeByFile>**/obj/**/*;**/bin/**/*;**/*.g.cs;**/*.razor.g.cs;**/*.designer.cs;**/GlobalUsings.g.cs;**/AssemblyInfo.cs</ExcludeByFile>

    <!-- Coverage Thresholds (Warning level, not failing) -->
    <ThresholdType>line,branch,method</ThresholdType>
    <Threshold>1,1,1</Threshold>
    <ThresholdStat>minimum</ThresholdStat>
    <DoesNotReturnAttribute>DoesNotReturnAttribute</DoesNotReturnAttribute>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" />
    <PackageReference Include="LightMock.Generator" />
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.Testing.Platform" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.msbuild">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\redmuffin.Blazor.StaticWeb\redmuffin.Blazor.StaticWeb.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Features\Pages\ArticlesPage\Core\Services\" />
  </ItemGroup>

</Project>
