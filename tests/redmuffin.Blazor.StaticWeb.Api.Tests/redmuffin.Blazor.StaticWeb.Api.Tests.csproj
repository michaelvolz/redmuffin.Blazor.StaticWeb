<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RunAOTCompilation>true</RunAOTCompilation>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- Code Coverage: Use TUnit native CLI (see Generate-CoverageReport.ps1) -->
    <DoesNotReturnAttribute>DoesNotReturnAttribute</DoesNotReturnAttribute>
  </PropertyGroup>
<ItemGroup>
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Core" />
    <!-- Microsoft.Azure.Functions.Worker.Sdk intentionally NOT referenced here.
         The SDK hijacks dotnet run to launch func start instead of the test host.
         Only the API project needs it. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.Testing.Platform" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\redmuffin.Blazor.StaticWeb.Api\redmuffin.Blazor.StaticWeb.Api.csproj" />
    <ProjectReference Include="..\..\src\redmuffin.Blazor.StaticWeb.Common\redmuffin.Blazor.StaticWeb.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Data\" />
  </ItemGroup>

</Project>
