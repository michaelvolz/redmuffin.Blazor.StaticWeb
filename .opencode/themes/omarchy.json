{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "omarchyBg": "#1a1b26",
    "omarchyFg": "#a9b1d6",
    "omarchyAccent": "#7aa2f7",
    "omarchyRed": "#f7768e",
