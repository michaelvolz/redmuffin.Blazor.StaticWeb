    "omarchyYellow": "#e0af68",
    "omarchyBlue": "#7aa2f7",
    "omarchyMagenta": "#ad8ee6",
    "omarchyCyan": "#449dab",
    "omarchyGray": "#32344a"
  },
  "theme": {
