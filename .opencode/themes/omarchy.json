      "dark": "omarchyCyan",
      "light": "#8fbcbb"
    },
    "syntaxOperator": {
      "dark": "omarchyBlue",
      "light": "#5e81ac"
    },
    "syntaxPunctuation": {
      "dark": "omarchyFg",
      "light": "#2e3440"
    }
