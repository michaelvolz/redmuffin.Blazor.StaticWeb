      "dark": "omarchyAccent",
      "light": "omarchyBlue"
    },
    "secondary": {
      "dark": "omarchyMagenta",
      "light": "omarchyMagenta"
    },
    "accent": {
      "dark": "omarchyCyan",
      "light": "omarchyAccent"
    },
    "error": {
      "dark": "omarchyRed",
      "light": "omarchyRed"
    },
    "warning": {
      "dark": "omarchyYellow",
      "light": "omarchyYellow"
    },
    "success": {
      "dark": "omarchyGreen",
      "light": "omarchyGreen"
    },
    "info": {
      "dark": "omarchyCyan",
      "light": "omarchyBlue"
