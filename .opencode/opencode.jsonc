{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "default_agent": "rm-karpathy-universal-primary-agent",
  "watcher": {
    "ignore": [
      ".git/**",
      "**/bin/**",
      "**/obj/**",
      ".vs/**",
      "**/packages/**",
      "**/TestResults/**",
      "**/artifacts/**",
      "**/publish/**"
    ]
  },
  "provider": {
    "deepseek": {
      "models": {
        "deepseek-v4-pro": {
          "limit": {
            "context": 393216,
            "output": 262144
          },
          "options": {
            "thinking": { "type": "enabled" },
            "reasoning_effort": "max"
          }
        }
      }
    },
    "opencode-go": {
      "models": {
        "deepseek-v4-pro": {
          "limit": {
            "context": 393216,
            "output": 262144
          },
          "options": {
            "thinking": { "type": "enabled" },
            "reasoning_effort": "max"
          }
        }
      }
    },
    "xai": {
      "models": {
        "grok-4.3": {
          "limit": {
            "context": 393216,
            "output": 262144
          },
          "options": {
            "thinking": { "type": "enabled" },
            "reasoning_effort": "max"
          }
        }
      }
    }
  },
  "plugin": [
    "opencode-snippets",
    "cc-safety-net",
    "@cortexkit/opencode-magic-context@latest",
    "opencode-bytheway"
  ],
  "compaction": {
    "auto": false,
    "prune": false
  },
  "permission": {
    // IMPORTANT: The following long deny list is INTENTIONALLY duplicated
    // in read, edit, glob, grep, and bash for maximum defense-in-depth.
    // Glob and grep can leak secrets, so they must have the full list.
    // Do NOT remove or shorten any entry.
    "skill": {
      "git-commit": "deny",
      "git-commit-push-pr": "deny",
      "ce-dhh-rails-style": "deny",
      "ce-riffrec-feedback-analysis": "deny",
      "ce-test-xcode": "deny",
      "ce-gemini-imagegen": "deny",
      "ce-product-pulse": "deny",
      "ce-demo-reel": "deny"
    },
    "read": {
      "*": "allow",
      "**/.env*": "deny",
      "**/secrets*": "deny",
      "**/*.env.example": "allow",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.config/gnupg/**": "deny",
      "~/.aws/**": "deny",
      "~/.azure/**": "deny",
      "~/.config/gcloud/**": "deny",
      "~/.config/azure/**": "deny",
      "~/.kube/**": "deny",
      "~/.docker/**": "deny",
      "~/.config/docker/**": "deny",
      "~/.config/1Password/**": "deny",
      "~/.config/Bitwarden/**": "deny",
      "~/.local/share/keyrings/**": "deny",
      "~/AppData/Local/Google/Chrome/User Data/**": "deny",
      "~/AppData/Local/Microsoft/Edge/User Data/**": "deny",
      "~/.mozilla/**": "deny",
      "~/.bash_history": "deny",
      "~/.zsh_history": "deny",
      "~/.config/fish/fish_history": "deny",
      "~/.local/share/fish/fish_history": "deny",
      "~/Documents/**": "deny",
      "~/OneDrive/Documents/**": "deny",
      "~/Desktop/**": "deny",
      "~/OneDrive/Desktop/**": "deny",
      "~/Pictures/**": "deny",
      "~/OneDrive/Pictures/**": "deny",
      "~/Videos/**": "deny",
      "~/OneDrive/Videos/**": "deny",
      "~/Music/**": "deny",
      "~/OneDrive/Music/**": "deny",
      "~/Downloads/**": "deny",
      "~/Favorites/**": "deny",
      "~/Public/**": "deny",
      "~/.config/autostart/**": "deny",
      "~/.config/systemd/user/**": "deny",
      "~/.gitconfig": "deny",
      "~/.config/git/**": "deny",
      "~/.config/Code/User/**": "deny",
      "~/AppData/Roaming/Code/User/**": "deny",
      "**/.vscode/tasks.json": "deny",
      "**/.vscode/settings.json": "deny",
      "**/.vscode/launch.json": "deny",
      "~/AppData/Local/Microsoft/VisualStudio/**": "deny",
      "~/AppData/Roaming/Microsoft/VisualStudio/**": "deny",
      "**/.git/hooks/**": "deny",
      "**/.git/config": "deny",
      "~/.local/share/applications/**": "deny"
    },
    "edit": {
