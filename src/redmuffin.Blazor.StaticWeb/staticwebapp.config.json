{
  "platform": {
    "apiRuntime": "dotnet:8.0"
  },
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; connect-src 'self' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; img-src * data:; font-src 'self' https://cdnjs.cloudflare.com https://fonts.gstatic.com;",
    "Cross-Origin-Resource-Policy": "cross-origin",
    "Permissions-Policy": ""
  },
  "trailingSlash": "auto",
  "routes": [
    {
      "route": "/",
      "headers": {
        "Cache-Control": "must-revalidate, max-age=604800"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "Cache-Control": "must-revalidate, max-age=604800"
      }
    },
    {
      "route": "/redmuffin.Blazor.StaticWeb.styles.css",
      "headers": {
        "Cache-Control": "must-revalidate, max-age=604800"
      }
    },
    {
      "route": "/css/*",
      "headers": {
        "Cache-Control": "must-revalidate, max-age=604800"
      }
    },
    {
      "route": "/lib/fontAwesome-free/webfonts/*",
      "headers": {
        "Cache-Control": "must-revalidate, max-age=604800"
      }
    },
    {
      "route": "/sample-data/*",
      "headers": {
        "Cache-Control": "must-revalidate, max-age=604800"
      }
    },
    {
      "route": "/_framework/*",
      "headers": {
        "Cache-Control": "must-revalidate, max-age=604800"
      }
    },
    {
      "route": "/favicon.png",
      "headers": {
        "Cache-Control": "must-revalidate, max-age=604800"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/sample-data/*",
      "/css/*",
      "/lib/fontAwesome-free/webfonts/*"
    ]
  },
  "mimeTypes": {
    ".json": "text/json",
    ".woff": "font/woff",
    ".woff2": "font/woff2",
    ".ttf": "font/ttf",
    ".eot": "application/vnd.ms-fontobject",
    ".otf": "font/otf"
  }
}