{
  "platform": {
    "apiRuntime": "dotnet-isolated:9.0"
  },
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; connect-src 'self' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src * data:; font-src 'self';",
    "Cross-Origin-Resource-Policy": "cross-origin",
    "Permissions-Policy": "",
    "Vary": "Accept-Encoding",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "trailingSlash": "auto",
  "routes": [
    {
      "route": "/",
      "headers": {
        "Cache-Control": "must-revalidate, max-age=604800"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "Cache-Control": "must-revalidate, max-age=604800"
      }
    },
    {
      "route": "/_framework/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/js/page-load-timing.*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/css/app.min.*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/css/*",
      "headers": {
        "Cache-Control": "must-revalidate, max-age=604800"
      }
    },
    {
      "route": "/fonts/*",
      "headers": {
        "Cache-Control": "must-revalidate, max-age=604800"
      }
    },
    {
      "route": "/sample-data/*",
      "headers": {
        "Cache-Control": "must-revalidate, max-age=604800"
      }
    },
    {
      "route": "/favicon.png",
      "headers": {
        "Cache-Control": "must-revalidate, max-age=604800"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/robots.txt",
      "/llms.txt",
      "/fonts/*",
      "/sample-data/*",
      "/css/*",
      "/js/*",
      "/lib/fontAwesome-free/webfonts/*"
    ]
  },
  "mimeTypes": {
    ".json": "text/json",
    ".woff": "font/woff",
    ".woff2": "font/woff2",
    ".ttf": "font/ttf",
    ".eot": "application/vnd.ms-fontobject",
    ".otf": "font/otf"
  }
}
