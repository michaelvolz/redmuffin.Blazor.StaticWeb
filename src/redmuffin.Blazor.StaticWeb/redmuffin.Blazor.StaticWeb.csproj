<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <DOTNET_WATCH_LOG_PREFIX>Blazor</DOTNET_WATCH_LOG_PREFIX>
  </PropertyGroup>

  <!--
    CORE PROJECT SETTINGS
    Basic framework and language settings that apply to all configurations
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- WASM0001: false positive from MSBuild framework P/Invoke in inline C# tasks.
         GetModuleFileName is in build-only assemblies, never shipped to browser. -->
    <NoWarn>$(NoWarn);WASM0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="JSModule" Pattern="*.js" Expression="#[.{fingerprint}]!" />
    <!-- Source JS files kept in wwwroot for dev but excluded from publish.
         Only the minified version (*.min.js) is deployed and fingerprinted. -->
    <Content Update="wwwroot\js\page-load-timing.js" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!--
    DEBUG CONFIGURATION: Optimized for fast builds and AI agent workflows
    These settings prioritize compilation speed over runtime performance and bundle size
  -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <!-- Disable WASM SIMD optimizations for faster debug builds -->
    <WasmEnableSIMD>false</WasmEnableSIMD>
    <!-- Disable trimming to speed up compilation (larger bundle, but faster builds) -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Suppress trim analysis warnings since trimming is disabled in debug -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

  <!--
    RELEASE CONFIGURATION: Optimized for minimal bundle size and fast loading
    Note: AOT compilation is DISABLED because it increases file size by 1.5-2x
    while only improving runtime performance. Since this app prioritizes
    download size and first-load time over runtime performance, we use
    IL interpretation with aggressive trimming instead.
    
    Key optimizations:
    - Full trimming removes unused code (PublishTrimmed + TrimMode=full)
    - Brotli compression reduces download size by ~70%
    - No AoT = smaller runtime, faster builds (~3min vs ~14min)
  -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <!-- Disable AOT compilation - AoT increases file size significantly -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <!-- Disable WASM SIMD for smaller bundle -->
    <WasmEnableSIMD>false</WasmEnableSIMD>
    <!-- Enable trimming (partial mode — Blazor SDK default, safe for WASM) -->
    <PublishTrimmed>true</PublishTrimmed>
      <!-- Specify trimmer descriptor to preserve essential types -->
      <TrimmerRootDescriptor>$(MSBuildProjectDirectory)/TrimmerRoots.xml</TrimmerRootDescriptor>
      <!-- Enable lazy loading for non-critical assemblies -->
      <BlazorWebAssemblyLazyLoad>true</BlazorWebAssemblyLazyLoad>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blazored.LocalStorage" />
    <PackageReference Include="LZStringCSharp" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Mediator.SourceGenerator" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <!-- SCSS compiled by dart-sass CLI. No NuGet package needed. -->

  <ItemGroup>
    <AdditionalFiles Remove="C:\Users\flynn\.nuget\packages\microsoft.visualstudio.threading.analyzers\17.8.14\build\AdditionalFiles\vs-threading.LegacyThreadSwitchingMembers.txt" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Remove="C:\Users\flynn\.nuget\packages\microsoft.visualstudio.threading.analyzers\17.8.14\build\AdditionalFiles\vs-threading.MainThreadAssertingMethods.txt" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Remove="C:\Users\flynn\.nuget\packages\microsoft.visualstudio.threading.analyzers\17.8.14\build\AdditionalFiles\vs-threading.MainThreadSwitchingMethods.txt" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Remove="C:\Users\flynn\.nuget\packages\microsoft.visualstudio.threading.analyzers\17.8.14\build\AdditionalFiles\vs-threading.MembersRequiringMainThread.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\redmuffin.Blazor.StaticWeb.Common\redmuffin.Blazor.StaticWeb.Common.csproj" />
    <ProjectReference Include="..\redmuffin.Blazor.StaticWeb.Modules\ApiHealth\ApiHealth.csproj" />
    <ProjectReference Include="..\redmuffin.Blazor.StaticWeb.Modules\ApiHealth.Contracts\ApiHealth.Contracts.csproj" />
  </ItemGroup>

  <!--
    CSS FINGERPRINTING TARGET (Release only)
    SHA-256 hashes app.min.css, renames it with content hash in filename,
    and rewrites index.html references. .br/.gz companions are also renamed.
    Blazor's built-in fingerprinting only handles JS modules — CSS gets this
    custom target. Only runs on Release (production) builds.
  -->
  <UsingTask TaskName="ReplaceFileText"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <FilePath ParameterType="System.String" Required="true" />
      <FindText ParameterType="System.String" Required="true" />
      <ReplaceWith ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs">
        string content = File.ReadAllText(FilePath);
        content = content.Replace(FindText, ReplaceWith);
        File.WriteAllText(FilePath, content);
      </Code>
    </Task>
  </UsingTask>

  <Target Name="FingerprintCustomCssAssets" AfterTargets="Publish"
          Condition="'$(Configuration)' == 'Release'">

    <PropertyGroup>
      <CssFilePath>$([System.IO.Path]::Combine('$(PublishDir)', 'wwwroot', 'css', 'app.min.css'))</CssFilePath>
      <IndexHtmlPath>$([System.IO.Path]::Combine('$(PublishDir)', 'wwwroot', 'index.html'))</IndexHtmlPath>
    </PropertyGroup>

    <GetFileHash Files="$(CssFilePath)" Algorithm="SHA256" HashEncoding="hex"
                 Condition="Exists('$(CssFilePath)')">
      <Output TaskParameter="Hash" PropertyName="CssHash" />
    </GetFileHash>

    <PropertyGroup Condition="'$(CssHash)' != ''">
      <CssHash8>$(CssHash.Substring(0,8))</CssHash8>
      <NewCssName>app.min.$(CssHash8).css</NewCssName>
      <NewCssPath>$([System.IO.Path]::Combine('$(PublishDir)', 'wwwroot', 'css', '$(NewCssName)'))</NewCssPath>
    </PropertyGroup>

    <Message Importance="high" Text="Fingerprinting CSS: app.min.css -> $(NewCssName) (SHA256=$(CssHash8))"
             Condition="'$(CssHash)' != ''" />
    <Error Text="CSS fingerprinting failed: app.min.css missing from publish output. This file must be compiled from SCSS and committed before deploy. Locally: sass --style=compressed --no-source-map scss/app.scss:wwwroot/css/app.min.css. In CI: commit the compiled app.min.css." Condition="!Exists('$(CssFilePath)')" />

    <!-- Rename CSS + compressed companions -->
    <Move SourceFiles="$(CssFilePath)" DestinationFiles="$(NewCssPath)"
          Condition="Exists('$(CssFilePath)') And '$(CssHash)' != ''" />
    <Move SourceFiles="$(CssFilePath).br" DestinationFiles="$(NewCssPath).br"
          Condition="$([System.IO.File]::Exists('$(CssFilePath).br')) And '$(CssHash)' != ''" />
    <Move SourceFiles="$(CssFilePath).gz" DestinationFiles="$(NewCssPath).gz"
          Condition="$([System.IO.File]::Exists('$(CssFilePath).gz')) And '$(CssHash)' != ''" />

    <!-- Rewrite index.html to reference fingerprinted CSS -->
    <ReplaceFileText FilePath="$(IndexHtmlPath)"
                     FindText="css/app.min.css"
                     ReplaceWith="css/$(NewCssName)"
                     Condition="'$(CssHash)' != ''" />

    <Message Importance="high" Text="Updated index.html with fingerprinted CSS reference: css/$(NewCssName)"
             Condition="'$(CssHash)' != ''" />
  </Target>

  <Target Name="CopyStaticWebAppConfig" AfterTargets="Publish">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\staticwebapp.config.json"
          DestinationFiles="$(PublishDir)wwwroot\staticwebapp.config.json"
          Condition="Exists('$(MSBuildProjectDirectory)\staticwebapp.config.json')" />
  </Target>

</Project>
