@page "/api-health"
@using Mediator
@using redmuffin.Blazor.StaticWeb.Modules.ApiHealth.Contracts

<PageTitle>ApiHealth</PageTitle>

<h1>ApiHealth</h1>

<button class="button" @onclick="CallApiAsync">Call ApiHealth</button>

@if (!string.IsNullOrEmpty(_apiResponse))
{
    <p>
        <strong>API Response:</strong> @_apiResponse
    </p>
}
@if (!string.IsNullOrEmpty(_errorMessage))
{
    <p style="color: red;">
        <strong>Error:</strong> @_errorMessage
    </p>
}
