@using Microsoft.JSInterop
@using redmuffin.Blazor.StaticWeb.Common.Raindrop
@using redmuffin.Blazor.StaticWeb.Core.ImagePlaceholder.Abstractions

<div class="card @GetCardClass()">
    <div class="card-divider">
        <h5>@DisplayTitle(Item)</h5>
    </div>
    <div class="shimmer-placeholder" id="shimmer-@Item.Id">
        <img src="@GetImageUrl()" alt="@GetImageAlt()"
             loading="@(IsEagerLoad ? "eager" : "lazy")"
             fetchpriority="@(IsEagerLoad ? "high" : "low")"
             decoding="async"
             @onload="@(() => HandleImageLoadAsync(true))"
             @onerror="@(() => HandleImageLoadAsync(false))"/>
        @if (HasFallbackPlaceholder())
        {
            <div class="fallback-placeholder-overlay">
                <i class="fas fa-image"></i>
                <span>@GetFallbackReason()</span>
            </div>
        }
    </div>
    <div class="card-section">
        <p>@DisplayExcerpt(Item)</p>
        <p><i class="fas fa-calendar-alt"></i> Created: @Item.Created.ToString("yyyy-MM-dd")</p>
        <a href="@Item.Link" target="_blank" class="button">
            <i class="fas @GetButtonIcon()"></i> @GetButtonText()
        </a>
    </div>
</div>
