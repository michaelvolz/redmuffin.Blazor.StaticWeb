@using redmuffin.Blazor.StaticWeb.Configuration
@namespace redmuffin.Blazor.StaticWeb.Features.Common.PageLoadSpeed.Components

@if (PageLoadSpeedConfig.ShouldDisplayComponent(Navigation.BaseUri))
{
    <div class="page-speed-widget @(_isHidden ? "hidden" : "") @(_isCollapsed ? "collapsed" : "")"
         @onclick="ToggleVisibility"
         @ref="_speedElement">

        <div class="widget-header">
            <div class="widget-title">
                <span class="widget-icon">⚡</span>
                <span>Page Performance</span>
            </div>
            <div class="widget-controls">
                <span class="widget-time">@_currentMetrics?.FormattedTimestamp</span>
                <button type="button" class="toggle-button" @onclick:stopPropagation="true" @onclick="ToggleCollapsed">
                    @(_isCollapsed ? "+" : "−")
                </button>
            </div>
        </div>

        @if (!_isCollapsed)
        {
            <div class="widget-content">
                <!-- Core Metrics Grid -->
                <div class="metrics-grid">
                    <!-- Timing Metrics -->
                    <div class="metric-group">
                        <div class="metric-group-title">
                            <span>⏱️</span>
                            <span>Timing (ms)</span>
                        </div>
                        <div class="metric-item">
                            <span class="metric-label">TTFB:</span>
                            <span class="metric-value timing">@Math.Round(_currentMetrics?.Timing.TimeToFirstByte ?? 0, 1)</span>
                        </div>
                        @if ((_currentMetrics?.Timing.TimeToFirstByte ?? 0) > 0)
                        {
                            <div class="metric-progress">
                                <div class="metric-progress-bar" style="width: @(GetProgressWidth(_currentMetrics?.Timing.TimeToFirstByte ?? 0, 500))%; background: #ffd700;"></div>
                            </div>
                        }

                        <div class="metric-item">
                            <span class="metric-label">FCP:</span>
                            <span class="metric-value timing">@Math.Round(_currentMetrics?.Timing.FirstContentfulPaint ?? 0, 1)</span>
                        </div>
                        @if ((_currentMetrics?.Timing.FirstContentfulPaint ?? 0) > 0)
                        {
                            <div class="metric-progress">
                                <div class="metric-progress-bar" style="width: @(GetProgressWidth(_currentMetrics?.Timing.FirstContentfulPaint ?? 0, 1800))%; background: #ffd700;"></div>
                            </div>
                        }

                        <div class="metric-item">
                            <span class="metric-label">DOM:</span>
                            <span class="metric-value timing">@Math.Round(_currentMetrics?.Timing.DomContentLoaded ?? 0, 1)</span>
                        </div>
                        @if ((_currentMetrics?.Timing.DomContentLoaded ?? 0) > 0)
                        {
                            <div class="metric-progress">
                                <div class="metric-progress-bar" style="width: @(GetProgressWidth(_currentMetrics?.Timing.DomContentLoaded ?? 0, 2000))%; background: #ffd700;"></div>
                            </div>
                        }

                        <div class="metric-item">
                            <span class="metric-label">LCP:</span>
                            <span class="metric-value timing">@Math.Round(_currentMetrics?.Timing.LargestContentfulPaint ?? 0, 1)</span>
                        </div>
                        @if ((_currentMetrics?.Timing.LargestContentfulPaint ?? 0) > 0)
                        {
                            <div class="metric-progress">
                                <div class="metric-progress-bar" style="width: @(GetProgressWidth(_currentMetrics?.Timing.LargestContentfulPaint ?? 0, 2500))%; background: @GetTimingColor(_currentMetrics?.Timing.LargestContentfulPaint ?? 0)"></div>
                            </div>
                        }

                        <div class="metric-item">
                            <span class="metric-label">Load:</span>
                            <span class="metric-value timing">@Math.Round(_currentMetrics?.Timing.LoadComplete ?? 0, 1)</span>
                        </div>
                        @if ((_currentMetrics?.Timing.LoadComplete ?? 0) > 0)
                        {
                            <div class="metric-progress">
                                <div class="metric-progress-bar" style="width: @(GetProgressWidth(_currentMetrics?.Timing.LoadComplete ?? 0, 3000))%; background: @GetTimingColor(_currentMetrics?.Timing.LoadComplete ?? 0)"></div>
                            </div>
                        }
                    </div>

                    <!-- Data Transfer Metrics -->
                    <div class="metric-group">
                        <div class="metric-group-title">
                            <span>📊</span>
                            <span>Data Transfer</span>
                        </div>
                        <div class="metric-item">
                            <span class="metric-label">Transfer:</span>
                            <span class="metric-value size">@(_currentMetrics?.Size.TransferSizeFormatted ?? "0 B")</span>
                        </div>
                        @if ((_currentMetrics?.Size.TransferSize ?? 0) > 0)
                        {
                            <div class="metric-progress">
                                <div class="metric-progress-bar" style="width: @(GetDataSizeProgress(_currentMetrics?.Size.TransferSize ?? 0))%; background: #00bfff;"></div>
                            </div>
                        }

                        <div class="metric-item">
                            <span class="metric-label">Encoded:</span>
                            <span class="metric-value size">@(_currentMetrics?.Size.EncodedSizeFormatted ?? "0 B")</span>
                        </div>
                        @if ((_currentMetrics?.Size.EncodedSize ?? 0) > 0)
                        {
                            <div class="metric-progress">
                                <div class="metric-progress-bar" style="width: @(GetDataSizeProgress(_currentMetrics?.Size.EncodedSize ?? 0))%; background: #00bfff;"></div>
                            </div>
                        }

                        <div class="metric-item">
                            <span class="metric-label">Decoded:</span>
                            <span class="metric-value size">@(_currentMetrics?.Size.DecodedSizeFormatted ?? "0 B")</span>
                        </div>
                        @if ((_currentMetrics?.Size.DecodedSize ?? 0) > 0)
                        {
                            <div class="metric-progress">
                                <div class="metric-progress-bar" style="width: @(GetDataSizeProgress(_currentMetrics?.Size.DecodedSize ?? 0))%; background: #00bfff;"></div>
                            </div>
                        }

                        @if ((_currentMetrics?.Size.CompressionRatio ?? 0) > 0)
                        {
                            <div class="metric-item">
                                <span class="metric-label">Compression:</span>
                                <span class="metric-value ratio">
                                    @(_currentMetrics?.Size.CompressionRatio ?? 0)%
                                </span>
                            </div>
                            <div class="metric-progress">
                                <div class="metric-progress-bar" style="width: @(_currentMetrics?.Size.CompressionRatio ?? 0)%; background: #ff6b9d;"></div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Performance Breakdown -->
                @if (HasBreakdownMetrics())
                {
                    <div class="performance-breakdown">
                        <div class="metric-group-title">
                            <span>🔬</span>
                            <span>Performance Breakdown</span>
                        </div>
                        <div class="breakdown-grid">
                            @if ((_currentMetrics?.Calculated.ServerResponseTime ?? 0) > 0)
                            {
                                <div class="breakdown-item">
                                    <div class="metric-label">Server Response</div>
                                    <div class="metric-value breakdown">@Math.Round(_currentMetrics?.Calculated.ServerResponseTime ?? 0, 1)ms</div>
                                    <div class="metric-progress">
                                        <div class="metric-progress-bar" style="width: @(GetProgressWidth(_currentMetrics?.Calculated.ServerResponseTime ?? 0, 1000))%; background: #ff8c42;"></div>
                                    </div>
                                </div>
                            }
                            @if ((_currentMetrics?.Calculated.DomProcessingTime ?? 0) > 0)
                            {
                                <div class="breakdown-item">
                                    <div class="metric-label">DOM Processing</div>
                                    <div class="metric-value breakdown">@Math.Round(_currentMetrics?.Calculated.DomProcessingTime ?? 0, 1)ms</div>
                                    <div class="metric-progress">
                                        <div class="metric-progress-bar" style="width: @(GetProgressWidth(_currentMetrics?.Calculated.DomProcessingTime ?? 0, 1000))%; background: #ff8c42;"></div>
                                    </div>
                                </div>
                            }
                            @if ((_currentMetrics?.Calculated.ResourceLoadTime ?? 0) > 0)
                            {
                                <div class="breakdown-item">
                                    <div class="metric-label">Resource Load</div>
                                    <div class="metric-value breakdown">@Math.Round(_currentMetrics?.Calculated.ResourceLoadTime ?? 0, 1)ms</div>
                                    <div class="metric-progress">
                                        <div class="metric-progress-bar" style="width: @(GetProgressWidth(_currentMetrics?.Calculated.ResourceLoadTime ?? 0, 1000))%; background: #ff8c42;"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Performance Rating -->
                <div class="performance-rating">
                    <div class="rating-badge @PerformanceCache.CssClass">
                        <span>@PerformanceCache.Icon</span>
                        <span>@PerformanceCache.RatingText</span>
                    </div>
                    @if (PerformanceCache.Score > 0)
                    {
                        <div style="margin-top: 8px; font-size: 10px; color: #888;">
                            Score: @PerformanceCache.Score/100
                        </div>
                    }
                </div>

                <!-- Refresh Button -->
                <div style="text-align: center; margin-top: 12px;">
                    <button type="button" class="refresh-button" @onclick="RefreshMetricsAsync" @onclick:stopPropagation="true" disabled="@_isRefreshing">
                        <span>@(_isRefreshing ? "🔄" : "🔄")</span>
                        <span>@(_isRefreshing ? "Refreshing..." : "Refresh")</span>
                    </button>
                </div>
            </div>
        }
    </div>
}