@inject IPerformanceMetricsService PerformanceService
@inject NavigationManager Navigation
@using redmuffin.Blazor.StaticWeb.Configuration
@using redmuffin.Blazor.StaticWeb.Features.Common.PageLoadSpeed.Core
@implements IAsyncDisposable

@if (PageLoadSpeedConfig.ShouldDisplayComponent(Navigation.BaseUri))
{
    <div class="page-speed-widget @(_isHidden ? "hidden" : "") @(_isCollapsed ? "collapsed" : "")"
         @onclick="ToggleVisibility"
         @ref="_speedElement">

        <div class="widget-header">
            <div class="widget-title">
                <span class="widget-icon">⚡</span>
                <span>Page Performance</span>
            </div>
            <div class="widget-controls">
                <span class="widget-time">@_currentMetrics?.FormattedTimestamp</span>
                <button type="button" class="toggle-button" @onclick:stopPropagation="true" @onclick="ToggleCollapsed">
                    @(_isCollapsed ? "+" : "−")
                </button>
            </div>
        </div>

        @if (!_isCollapsed)
        {
            <div class="widget-content">
                <!-- Core Metrics Grid -->
                <div class="metrics-grid">
                    <!-- Timing Metrics -->
                    <div class="metric-group">
                        <div class="metric-group-title">
                            <span>⏱️</span>
                            <span>Timing (ms)</span>
                        </div>
                        <div class="metric-item">
                            <span class="metric-label">TTFB:</span>
                            <span class="metric-value timing">@Math.Round(_currentMetrics?.Timing.TimeToFirstByte ?? 0, 1)</span>
                        </div>
                        @if ((_currentMetrics?.Timing.TimeToFirstByte ?? 0) > 0)
                        {
                            <div class="metric-progress">
                                <div class="metric-progress-bar" style="width: @(GetProgressWidth(_currentMetrics?.Timing.TimeToFirstByte ?? 0, 500))%; background: #ffd700;"></div>
                            </div>
                        }

                        <div class="metric-item">
                            <span class="metric-label">FCP:</span>
                            <span class="metric-value timing">@Math.Round(_currentMetrics?.Timing.FirstContentfulPaint ?? 0, 1)</span>
                        </div>
                        @if ((_currentMetrics?.Timing.FirstContentfulPaint ?? 0) > 0)
                        {
                            <div class="metric-progress">
                                <div class="metric-progress-bar" style="width: @(GetProgressWidth(_currentMetrics?.Timing.FirstContentfulPaint ?? 0, 1800))%; background: #ffd700;"></div>
                            </div>
                        }

                        <div class="metric-item">
                            <span class="metric-label">DOM:</span>
                            <span class="metric-value timing">@Math.Round(_currentMetrics?.Timing.DomContentLoaded ?? 0, 1)</span>
                        </div>
                        @if ((_currentMetrics?.Timing.DomContentLoaded ?? 0) > 0)
                        {
                            <div class="metric-progress">
                                <div class="metric-progress-bar" style="width: @(GetProgressWidth(_currentMetrics?.Timing.DomContentLoaded ?? 0, 2000))%; background: #ffd700;"></div>
                            </div>
                        }

                        <div class="metric-item">
                            <span class="metric-label">LCP:</span>
                            <span class="metric-value timing">@Math.Round(_currentMetrics?.Timing.LargestContentfulPaint ?? 0, 1)</span>
                        </div>
                        @if ((_currentMetrics?.Timing.LargestContentfulPaint ?? 0) > 0)
                        {
                            <div class="metric-progress">
                                <div class="metric-progress-bar" style="width: @(GetProgressWidth(_currentMetrics?.Timing.LargestContentfulPaint ?? 0, 2500))%; background: @GetTimingColor(_currentMetrics?.Timing.LargestContentfulPaint ?? 0)"></div>
                            </div>
                        }

                        <div class="metric-item">
                            <span class="metric-label">Load:</span>
                            <span class="metric-value timing">@Math.Round(_currentMetrics?.Timing.LoadComplete ?? 0, 1)</span>
                        </div>
                        @if ((_currentMetrics?.Timing.LoadComplete ?? 0) > 0)
                        {
                            <div class="metric-progress">
                                <div class="metric-progress-bar" style="width: @(GetProgressWidth(_currentMetrics?.Timing.LoadComplete ?? 0, 3000))%; background: @GetTimingColor(_currentMetrics?.Timing.LoadComplete ?? 0)"></div>
                            </div>
                        }
                    </div>

                    <!-- Data Transfer Metrics -->
                    <div class="metric-group">
                        <div class="metric-group-title">
                            <span>📊</span>
                            <span>Data Transfer</span>
                        </div>
                        <div class="metric-item">
                            <span class="metric-label">Transfer:</span>
                            <span class="metric-value size">@(_currentMetrics?.Size.TransferSizeFormatted ?? "0 B")</span>
                        </div>
                        @if ((_currentMetrics?.Size.TransferSize ?? 0) > 0)
                        {
                            <div class="metric-progress">
                                <div class="metric-progress-bar" style="width: @(GetDataSizeProgress(_currentMetrics?.Size.TransferSize ?? 0))%; background: #00bfff;"></div>
                            </div>
                        }

                        <div class="metric-item">
                            <span class="metric-label">Encoded:</span>
                            <span class="metric-value size">@(_currentMetrics?.Size.EncodedSizeFormatted ?? "0 B")</span>
                        </div>
                        @if ((_currentMetrics?.Size.EncodedSize ?? 0) > 0)
                        {
                            <div class="metric-progress">
                                <div class="metric-progress-bar" style="width: @(GetDataSizeProgress(_currentMetrics?.Size.EncodedSize ?? 0))%; background: #00bfff;"></div>
                            </div>
                        }

                        <div class="metric-item">
                            <span class="metric-label">Decoded:</span>
                            <span class="metric-value size">@(_currentMetrics?.Size.DecodedSizeFormatted ?? "0 B")</span>
                        </div>
                        @if ((_currentMetrics?.Size.DecodedSize ?? 0) > 0)
                        {
                            <div class="metric-progress">
                                <div class="metric-progress-bar" style="width: @(GetDataSizeProgress(_currentMetrics?.Size.DecodedSize ?? 0))%; background: #00bfff;"></div>
                            </div>
                        }

                        @if ((_currentMetrics?.Size.CompressionRatio ?? 0) > 0)
                        {
                            <div class="metric-item">
                                <span class="metric-label">Compression:</span>
                                <span class="metric-value ratio">@(_currentMetrics?.Size.CompressionRatio ?? 0)%</span>
                            </div>
                            <div class="metric-progress">
                                <div class="metric-progress-bar" style="width: @(_currentMetrics?.Size.CompressionRatio ?? 0)%; background: #ff6b9d;"></div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Performance Breakdown -->
                @if (HasBreakdownMetrics())
                {
                    <div class="performance-breakdown">
                        <div class="metric-group-title">
                            <span>🔬</span>
                            <span>Performance Breakdown</span>
                        </div>
                        <div class="breakdown-grid">
                            @if ((_currentMetrics?.Calculated.ServerResponseTime ?? 0) > 0)
                            {
                                <div class="breakdown-item">
                                    <div class="metric-label">Server Response</div>
                                    <div class="metric-value breakdown">@Math.Round(_currentMetrics?.Calculated.ServerResponseTime ?? 0, 1)ms</div>
                                    <div class="metric-progress">
                                        <div class="metric-progress-bar" style="width: @(GetProgressWidth(_currentMetrics?.Calculated.ServerResponseTime ?? 0, 1000))%; background: #ff8c42;"></div>
                                    </div>
                                </div>
                            }
                            @if ((_currentMetrics?.Calculated.DomProcessingTime ?? 0) > 0)
                            {
                                <div class="breakdown-item">
                                    <div class="metric-label">DOM Processing</div>
                                    <div class="metric-value breakdown">@Math.Round(_currentMetrics?.Calculated.DomProcessingTime ?? 0, 1)ms</div>
                                    <div class="metric-progress">
                                        <div class="metric-progress-bar" style="width: @(GetProgressWidth(_currentMetrics?.Calculated.DomProcessingTime ?? 0, 1000))%; background: #ff8c42;"></div>
                                    </div>
                                </div>
                            }
                            @if ((_currentMetrics?.Calculated.ResourceLoadTime ?? 0) > 0)
                            {
                                <div class="breakdown-item">
                                    <div class="metric-label">Resource Load</div>
                                    <div class="metric-value breakdown">@Math.Round(_currentMetrics?.Calculated.ResourceLoadTime ?? 0, 1)ms</div>
                                    <div class="metric-progress">
                                        <div class="metric-progress-bar" style="width: @(GetProgressWidth(_currentMetrics?.Calculated.ResourceLoadTime ?? 0, 1000))%; background: #ff8c42;"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Performance Rating -->
                <div class="performance-rating">
                    <div class="rating-badge @PerformanceCache.CssClass">
                        <span>@PerformanceCache.Icon</span>
                        <span>@PerformanceCache.RatingText</span>
                    </div>
                    @if (PerformanceCache.Score > 0)
                    {
                        <div style="margin-top: 8px; font-size: 10px; color: #888;">
                            Score: @PerformanceCache.Score/100
                        </div>
                    }
                </div>

                <!-- Refresh Button -->
                <div style="text-align: center; margin-top: 12px;">
                    <button type="button" class="refresh-button" @onclick="RefreshMetrics" @onclick:stopPropagation="true" disabled="@_isRefreshing">
                        <span>@(_isRefreshing ? "🔄" : "🔄")</span>
                        <span>@(_isRefreshing ? "Refreshing..." : "Refresh")</span>
                    </button>
                </div>
            </div>
        }
    </div>
}

@code {
    private bool _isHidden;
    private bool _isCollapsed;
    private bool _isRefreshing;
    private ElementReference _speedElement;
    private PerformanceMetrics? _currentMetrics;
    private readonly CancellationTokenSource _cancellationTokenSource = new();

    // Cached performance data
    private PerformanceCache _performanceCache = PerformanceCache.Create(0);

    private PerformanceCache PerformanceCache
    {
        get
        {
            if (_currentMetrics.HasValue)
            {
                var newCache = _currentMetrics.Value.GetPerformanceCache();
                if (Math.Abs(newCache.PrimaryMetric - _performanceCache.PrimaryMetric) > 0.1)
                {
                    _performanceCache = newCache;
                }
            }

            return _performanceCache;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var shouldDisplay = PageLoadSpeedConfig.ShouldDisplayComponent(Navigation.BaseUri);

        if (firstRender && shouldDisplay)
        {
            try
            {
                // Initialize with empty metrics first to ensure UI shows something
                if (!_currentMetrics.HasValue)
                {
                    _currentMetrics = new PerformanceMetrics(
                        new TimingMetrics(0, 0, 0, 0, 0),
                        new SizeMetrics(0, 0, 0, "Loading...", "Loading...", "Loading..."),
                        new CalculatedMetrics(0, 0, 0),
                        DateTime.Now.ToString("HH:mm:ss"));
                    await InvokeAsync(StateHasChanged);
                }

                await Task.Delay(PageLoadSpeedConfig.AutoLoadDelayMs, _cancellationTokenSource.Token);
                await UpdateMetricsAsync();
            }
            catch (OperationCanceledException)
            {
                // Expected during disposal
            }
            catch (Exception)
            {
                // If initialization fails, component will still show UI with manual refresh option
            }
        }
    }

    private async Task UpdateMetricsAsync()
    {
        if (_cancellationTokenSource.IsCancellationRequested) return;

        try
        {
            // Try to get comprehensive metrics first
            var metrics = await PerformanceService.GetMetricsAsync(_cancellationTokenSource.Token);
            if (metrics != null)
            {
                _currentMetrics = PerformanceMetrics.FromPageLoadMetrics(metrics, DateTime.Now.ToString("HH:mm:ss"));
                return;
            }

            // Try legacy timing
            var legacyTimings = await PerformanceService.GetLegacyTimingAsync(_cancellationTokenSource.Token);
            if (legacyTimings != null && legacyTimings.Length >= 2)
            {
                var legacyMetrics = new PageLoadMetrics
                {
                    TimeToFirstByte = Math.Round(legacyTimings[1] * 0.3, 1),
                    DomContentLoaded = Math.Round(legacyTimings[1], 1),
                    LoadComplete = Math.Round(legacyTimings[0], 1),
                    FirstContentfulPaint = 0,
                    LargestContentfulPaint = 0,
                    TransferSize = 0,
                    EncodedSize = 0,
                    DecodedSize = 0,
                    TransferSizeFormatted = "Unknown",
                    EncodedSizeFormatted = "Unknown",
                    DecodedSizeFormatted = "Unknown",
                    ServerResponseTime = 0,
                    DomProcessingTime = 0,
                    ResourceLoadTime = 0
                };
                _currentMetrics = PerformanceMetrics.FromPageLoadMetrics(legacyMetrics, DateTime.Now.ToString("HH:mm:ss"));
                return;
            }

            // Use fallback timing
            var fallbackMetrics = await PerformanceService.GetFallbackTimingAsync();
            _currentMetrics = PerformanceMetrics.FromPageLoadMetrics(fallbackMetrics, DateTime.Now.ToString("HH:mm:ss"));
        }
        catch (OperationCanceledException)
        {
            // Expected during cancellation
        }
        catch (Exception)
        {
            // Use fallback on any error
            try
            {
                var fallbackMetrics = await PerformanceService.GetFallbackTimingAsync();
                _currentMetrics = PerformanceMetrics.FromPageLoadMetrics(fallbackMetrics, DateTime.Now.ToString("HH:mm:ss"));
            }
            catch
            {
                // Final fallback - create empty metrics
                _currentMetrics = new PerformanceMetrics(
                    new TimingMetrics(0, 0, 0, 0, 0),
                    new SizeMetrics(0, 0, 0, "Unknown", "Unknown", "Unknown"),
                    new CalculatedMetrics(0, 0, 0),
                    DateTime.Now.ToString("HH:mm:ss"));
            }
        }
        finally
        {
            // Ensure UI updates after any metrics update
            if (!_cancellationTokenSource.IsCancellationRequested)
            {
                try
                {
                    await InvokeAsync(StateHasChanged);
                }
                catch
                {
                    // If InvokeAsync fails, component might be disposed
                }
            }
        }
    }

    private void ToggleVisibility()
    {
        _isHidden = !_isHidden;
    }

    private void ToggleCollapsed()
    {
        _isCollapsed = !_isCollapsed;
    }

    private async Task RefreshMetrics()
    {
        if (_isRefreshing) return;

        _isRefreshing = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            await UpdateMetricsAsync();
        }
        finally
        {
            _isRefreshing = false;
            // UpdateMetricsAsync already calls StateHasChanged in finally block
        }
    }

    private bool HasBreakdownMetrics()
    {
        return (_currentMetrics?.Calculated.ServerResponseTime ?? 0) > 0 ||
               (_currentMetrics?.Calculated.DomProcessingTime ?? 0) > 0 ||
               (_currentMetrics?.Calculated.ResourceLoadTime ?? 0) > 0;
    }

    private static double GetProgressWidth(double value, double maxValue)
    {
        if (value <= 0 || maxValue <= 0) return 0;
        return Math.Min(100, value / maxValue * 100);
    }

    private static double GetDataSizeProgress(double sizeBytes)
    {
        // Progress based on typical web page size (1MB = 100%)
        const double maxSize = 1024 * 1024; // 1MB
        return Math.Min(100, sizeBytes / maxSize * 100);
    }

    private static string GetTimingColor(double timing)
    {
        return timing switch
        {
            <= 1000 => "#00ff41",
            <= 2500 => "#ffd700",
            <= 4000 => "#ff8c42",
            _ => "#ff4757"
        };
    }

    public ValueTask DisposeAsync()
    {
        _cancellationTokenSource.Cancel();
        _cancellationTokenSource.Dispose();
        return ValueTask.CompletedTask;
    }

    // Data model for JavaScript interop
    public class PageLoadMetrics
    {
        public double TimeToFirstByte { get; set; }
        public double DomContentLoaded { get; set; }
        public double LoadComplete { get; set; }
        public double FirstContentfulPaint { get; set; }
        public double LargestContentfulPaint { get; set; }

        public double TransferSize { get; set; }
        public double EncodedSize { get; set; }
        public double DecodedSize { get; set; }
        public string TransferSizeFormatted { get; set; } = "";
        public string EncodedSizeFormatted { get; set; } = "";
        public string DecodedSizeFormatted { get; set; } = "";

        public double ServerResponseTime { get; set; }
        public double DomProcessingTime { get; set; }
        public double ResourceLoadTime { get; set; }
    }

}