@inject IJSRuntime JS
@inject NavigationManager Navigation

@if (!IsLocalhost)
{
    <div class="page-speed-widget @(_isHidden ? "hidden" : "") @(_isCollapsed ? "collapsed" : "")"
         @onclick="ToggleVisibility"
         @ref="_speedElement">

        <div class="widget-header">
            <div class="widget-title">
                <span class="widget-icon">⚡</span>
                <span>Page Performance</span>
            </div>
            <div class="widget-controls">
                <span class="widget-time">@_currentTime</span>
                <button type="button" class="toggle-button" @onclick:stopPropagation="true" @onclick="ToggleCollapsed">
                    @(_isCollapsed ? "+" : "−")
                </button>
            </div>
        </div>

        @if (!_isCollapsed)
        {
            <div class="widget-content">
                <!-- Core Metrics Grid -->
                <div class="metrics-grid">
                    <!-- Timing Metrics -->
                    <div class="metric-group">
                        <div class="metric-group-title">
                            <span>⏱️</span>
                            <span>Timing (ms)</span>
                        </div>
                        <div class="metric-item">
                            <span class="metric-label">TTFB:</span>
                            <span class="metric-value timing">@Math.Round(_timeToFirstByte, 1)</span>
                        </div>
                        <div class="metric-progress">
                            <div class="metric-progress-bar" style="width: @(GetProgressWidth(_timeToFirstByte, 500))%; background: #ffd700;"></div>
                        </div>

                        <div class="metric-item">
                            <span class="metric-label">FCP:</span>
                            <span class="metric-value timing">@Math.Round(_firstContentfulPaint, 1)</span>
                        </div>
                        <div class="metric-progress">
                            <div class="metric-progress-bar" style="width: @(GetProgressWidth(_firstContentfulPaint, 1800))%; background: #ffd700;"></div>
                        </div>

                        <div class="metric-item">
                            <span class="metric-label">DOM:</span>
                            <span class="metric-value timing">@Math.Round(_domContentLoaded, 1)</span>
                        </div>
                        <div class="metric-progress">
                            <div class="metric-progress-bar" style="width: @(GetProgressWidth(_domContentLoaded, 2000))%; background: #ffd700;"></div>
                        </div>

                        <div class="metric-item">
                            <span class="metric-label">LCP:</span>
                            <span class="metric-value timing">@(_largestContentfulPaint > 0 ? Math.Round(_largestContentfulPaint, 1) : 0)</span>
                        </div>
                        <div class="metric-progress">
                            <div class="metric-progress-bar" style="width: @(GetProgressWidth(_largestContentfulPaint, 2500))%; background: @GetTimingColor(_largestContentfulPaint)"></div>
                        </div>

                        <div class="metric-item">
                            <span class="metric-label">Load:</span>
                            <span class="metric-value timing">@Math.Round(_loadComplete, 1)</span>
                        </div>
                        <div class="metric-progress">
                            <div class="metric-progress-bar" style="width: @(GetProgressWidth(_loadComplete, 3000))%; background: @GetTimingColor(_loadComplete)"></div>
                        </div>
                    </div>

                    <!-- Data Transfer Metrics -->
                    <div class="metric-group">
                        <div class="metric-group-title">
                            <span>📊</span>
                            <span>Data Transfer</span>
                        </div>
                        <div class="metric-item">
                            <span class="metric-label">Transfer:</span>
                            <span class="metric-value size">@_transferSizeFormatted</span>
                        </div>
                        @if (_transferSize > 0)
                        {
                            <div class="metric-progress">
                                <div class="metric-progress-bar" style="width: @(GetDataSizeProgress(_transferSize))%; background: #00bfff;"></div>
                            </div>
                        }

                        <div class="metric-item">
                            <span class="metric-label">Encoded:</span>
                            <span class="metric-value size">@_encodedSizeFormatted</span>
                        </div>
                        @if (_encodedSize > 0)
                        {
                            <div class="metric-progress">
                                <div class="metric-progress-bar" style="width: @(GetDataSizeProgress(_encodedSize))%; background: #00bfff;"></div>
                            </div>
                        }

                        <div class="metric-item">
                            <span class="metric-label">Decoded:</span>
                            <span class="metric-value size">@_decodedSizeFormatted</span>
                        </div>
                        @if (_decodedSize > 0)
                        {
                            <div class="metric-progress">
                                <div class="metric-progress-bar" style="width: @(GetDataSizeProgress(_decodedSize))%; background: #00bfff;"></div>
                            </div>
                        }

                        @if (_compressionRatio > 0)
                        {
                            <div class="metric-item">
                                <span class="metric-label">Compression:</span>
                                <span class="metric-value ratio">@_compressionRatio%</span>
                            </div>
                            <div class="metric-progress">
                                <div class="metric-progress-bar" style="width: @_compressionRatio%; background: #ff6b9d;"></div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Performance Breakdown -->
                @if (_serverResponseTime > 0 || _domProcessingTime > 0 || _resourceLoadTime > 0)
                {
                    <div class="performance-breakdown">
                        <div class="metric-group-title">
                            <span>🔬</span>
                            <span>Performance Breakdown</span>
                        </div>
                        <div class="breakdown-grid">
                            @if (_serverResponseTime > 0)
                            {
                                <div class="breakdown-item">
                                    <div class="metric-label">Server Response</div>
                                    <div class="metric-value breakdown">@Math.Round(_serverResponseTime, 1)ms</div>
                                    <div class="metric-progress">
                                        <div class="metric-progress-bar" style="width: @(GetProgressWidth(_serverResponseTime, 1000))%; background: #ff8c42;"></div>
                                    </div>
                                </div>
                            }
                            @if (_domProcessingTime > 0)
                            {
                                <div class="breakdown-item">
                                    <div class="metric-label">DOM Processing</div>
                                    <div class="metric-value breakdown">@Math.Round(_domProcessingTime, 1)ms</div>
                                    <div class="metric-progress">
                                        <div class="metric-progress-bar" style="width: @(GetProgressWidth(_domProcessingTime, 1000))%; background: #ff8c42;"></div>
                                    </div>
                                </div>
                            }
                            @if (_resourceLoadTime > 0)
                            {
                                <div class="breakdown-item">
                                    <div class="metric-label">Resource Load</div>
                                    <div class="metric-value breakdown">@Math.Round(_resourceLoadTime, 1)ms</div>
                                    <div class="metric-progress">
                                        <div class="metric-progress-bar" style="width: @(GetProgressWidth(_resourceLoadTime, 1000))%; background: #ff8c42;"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Performance Rating -->
                <div class="performance-rating">
                    <div class="rating-badge @GetPerformanceRatingClass()">
                        <span>@GetPerformanceRatingIcon()</span>
                        <span>@GetPerformanceRating()</span>
                    </div>
                    @if (GetPerformanceScore() > 0)
                    {
                        <div style="margin-top: 8px; font-size: 10px; color: #888;">
                            Score: @GetPerformanceScore()/100
                        </div>
                    }
                </div>

                <!-- Refresh Button -->
                <div style="text-align: center; margin-top: 12px;">
                    <button type="button" class="refresh-button" @onclick="RefreshMetrics" @onclick:stopPropagation="true">
                        <span>🔄</span>
                        <span>Refresh</span>
                    </button>
                </div>
            </div>
        }
    </div>
}

@code {
    private bool _isHidden = false;
    private bool _isCollapsed = false;
    private ElementReference _speedElement;
    private string _currentTime = "";

    // Timing metrics
    private double _timeToFirstByte = 0;
    private double _domContentLoaded = 0;
    private double _loadComplete = 0;
    private double _firstContentfulPaint = 0;
    private double _largestContentfulPaint = 0;

    // Size metrics
    private double _transferSize = 0;
    private double _encodedSize = 0;
    private double _decodedSize = 0;
    private string _transferSizeFormatted = "0 B";
    private string _encodedSizeFormatted = "0 B";
    private string _decodedSizeFormatted = "0 B";

    // Calculated metrics
    private double _serverResponseTime = 0;
    private double _domProcessingTime = 0;
    private double _resourceLoadTime = 0;
    private double _compressionRatio = 0;

    private bool IsLocalhost
    {
        get
        {
            var baseUri = new Uri(Navigation.BaseUri);
            return baseUri.Host.Equals("localhost", StringComparison.OrdinalIgnoreCase) ||
                   baseUri.Host.Equals("127.0.0.1", StringComparison.OrdinalIgnoreCase) ||
                   baseUri.Host.StartsWith("192.168.", StringComparison.OrdinalIgnoreCase) ||
                   baseUri.Host.StartsWith("10.", StringComparison.OrdinalIgnoreCase) ||
                   baseUri.Host.StartsWith("172.16.", StringComparison.OrdinalIgnoreCase);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !IsLocalhost)
        {
            await Task.Delay(1000);
            await UpdateMetricsAsync();
            await UpdateTimestamp();
        }
    }

    private async Task UpdateMetricsAsync()
    {
        try
        {
            var functionExists = await JS.InvokeAsync<bool>("eval", "typeof window.getPageLoadMetrics === 'function'");

            if (functionExists)
            {
                var metrics = await JS.InvokeAsync<PageLoadMetrics>("getPageLoadMetrics");
                if (metrics != null)
                {
                    _timeToFirstByte = metrics.TimeToFirstByte;
                    _domContentLoaded = metrics.DomContentLoaded;
                    _loadComplete = metrics.LoadComplete;
                    _firstContentfulPaint = metrics.FirstContentfulPaint;
                    _largestContentfulPaint = metrics.LargestContentfulPaint;

                    _transferSize = metrics.TransferSize;
                    _encodedSize = metrics.EncodedSize;
                    _decodedSize = metrics.DecodedSize;
                    _transferSizeFormatted = metrics.TransferSizeFormatted;
                    _encodedSizeFormatted = metrics.EncodedSizeFormatted;
                    _decodedSizeFormatted = metrics.DecodedSizeFormatted;

                    _serverResponseTime = metrics.ServerResponseTime;
                    _domProcessingTime = metrics.DomProcessingTime;
                    _resourceLoadTime = metrics.ResourceLoadTime;

                    if (_decodedSize > 0 && _encodedSize > 0)
                    {
                        _compressionRatio = Math.Round(((_decodedSize - _encodedSize) / _decodedSize) * 100, 1);
                    }
                }
                else
                {
                    await GetFallbackTiming();
                }
            }
            else
            {
                await GetLegacyTiming();
            }
        }
        catch (Exception)
        {
            await GetFallbackTiming();
        }
    }

    private async Task GetLegacyTiming()
    {
        try
        {
            var functionExists = await JS.InvokeAsync<bool>("eval", "typeof window.getPageLoadTimes === 'function'");

            if (functionExists)
            {
                var timings = await JS.InvokeAsync<double[]>("getPageLoadTimes");
                if (timings != null && timings.Length >= 2)
                {
                    _loadComplete = Math.Round(timings[0], 1);
                    _domContentLoaded = Math.Round(timings[1], 1);
                    _timeToFirstByte = Math.Round(_domContentLoaded * 0.3, 1);
                }
                else
                {
                    await GetFallbackTiming();
                }
            }
            else
            {
                await GetFallbackTiming();
            }
        }
        catch
        {
            await GetFallbackTiming();
        }
    }

    private async Task GetFallbackTiming()
    {
        try
        {
            var now = await JS.InvokeAsync<double>("performance.now");
            _loadComplete = Math.Round(now, 1);
            _domContentLoaded = Math.Round(now * 0.8, 1);
            _timeToFirstByte = Math.Round(now * 0.3, 1);
            _firstContentfulPaint = Math.Round(now * 0.6, 1);

            _transferSizeFormatted = "Unknown";
            _encodedSizeFormatted = "Unknown";
            _decodedSizeFormatted = "Unknown";
        }
        catch
        {
            var estimatedTime = DateTime.Now.Millisecond + 100;
            _loadComplete = estimatedTime;
            _domContentLoaded = estimatedTime * 0.8;
            _timeToFirstByte = estimatedTime * 0.3;
            _firstContentfulPaint = estimatedTime * 0.6;

            _transferSizeFormatted = "Unknown";
            _encodedSizeFormatted = "Unknown";
            _decodedSizeFormatted = "Unknown";
        }
    }

    private void ToggleVisibility()
    {
        _isHidden = !_isHidden;
    }

    private void ToggleCollapsed()
    {
        _isCollapsed = !_isCollapsed;
    }

    private async Task RefreshMetrics()
    {
        await UpdateMetricsAsync();
        UpdateTimestamp();
        StateHasChanged();
    }

    private void UpdateTimestamp()
    {
        _currentTime = DateTime.Now.ToString("HH:mm:ss");
        StateHasChanged();
    }

    private string GetPerformanceRating()
    {
        var primaryMetric = _largestContentfulPaint > 0 ? _largestContentfulPaint : _loadComplete;

        return primaryMetric switch
        {
            <= 1000 => "EXCELLENT",
            <= 2500 => "GOOD",
            <= 4000 => "FAIR",
            _ => "POOR"
        };
    }

    private string GetPerformanceRatingClass()
    {
        var primaryMetric = _largestContentfulPaint > 0 ? _largestContentfulPaint : _loadComplete;

        return primaryMetric switch
        {
            <= 1000 => "excellent",
            <= 2500 => "good",
            <= 4000 => "fair",
            _ => "poor"
        };
    }

    private string GetPerformanceRatingIcon()
    {
        var primaryMetric = _largestContentfulPaint > 0 ? _largestContentfulPaint : _loadComplete;

        return primaryMetric switch
        {
            <= 1000 => "🚀",
            <= 2500 => "✅",
            <= 4000 => "⚠️",
            _ => "🐌"
        };
    }

    private int GetPerformanceScore()
    {
        var primaryMetric = _largestContentfulPaint > 0 ? _largestContentfulPaint : _loadComplete;

        return primaryMetric switch
        {
            <= 1000 => 95,
            <= 1500 => 85,
            <= 2500 => 75,
            <= 4000 => 50,
            _ => 25
        };
    }

    private double GetProgressWidth(double value, double maxValue)
    {
        if (value <= 0 || maxValue <= 0) return 0;
        return Math.Min(100, (value / maxValue) * 100);
    }

    private double GetDataSizeProgress(double sizeBytes)
    {
        // Progress based on typical web page size (1MB = 100%)
        const double maxSize = 1024 * 1024; // 1MB
        return Math.Min(100, (sizeBytes / maxSize) * 100);
    }

    private string GetTimingColor(double timing)
    {
        return timing switch
        {
            <= 1000 => "#00ff41",
            <= 2500 => "#ffd700",
            <= 4000 => "#ff8c42",
            _ => "#ff4757"
        };
    }

    // Data model for JavaScript interop
    public class PageLoadMetrics
    {
        public double TimeToFirstByte { get; set; }
        public double DomContentLoaded { get; set; }
        public double LoadComplete { get; set; }
        public double FirstContentfulPaint { get; set; }
        public double LargestContentfulPaint { get; set; }

        public double TransferSize { get; set; }
        public double EncodedSize { get; set; }
        public double DecodedSize { get; set; }
        public string TransferSizeFormatted { get; set; } = "";
        public string EncodedSizeFormatted { get; set; } = "";
        public string DecodedSizeFormatted { get; set; } = "";

        public double ServerResponseTime { get; set; }
        public double DomProcessingTime { get; set; }
        public double ResourceLoadTime { get; set; }
    }
}
