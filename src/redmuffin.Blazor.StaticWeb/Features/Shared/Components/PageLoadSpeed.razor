@inject IJSRuntime JS

<div class="page-speed-widget @(isHidden ? "hidden" : "") @(isCollapsed ? "collapsed" : "")"
     @onclick="ToggleVisibility"
     @ref="speedElement">

    <div class="widget-header">
        <div class="widget-title">
            <span class="widget-icon">⚡</span>
            <span>Page Performance</span>
        </div>
        <div class="widget-controls">
            <span class="widget-time">@currentTime</span>
            <button type="button" class="toggle-button" @onclick:stopPropagation="true" @onclick="ToggleCollapsed">
                @(isCollapsed ? "+" : "−")
            </button>
        </div>
    </div>

    @if (!isCollapsed)
    {
        <div class="widget-content">
            <!-- Core Metrics Grid -->
            <div class="metrics-grid">
                <!-- Timing Metrics -->
                <div class="metric-group">
                    <div class="metric-group-title">
                        <span>⏱️</span>
                        <span>Timing (ms)</span>
                    </div>
                    <div class="metric-item">
                        <span class="metric-label">TTFB:</span>
                        <span class="metric-value timing">@Math.Round(timeToFirstByte, 1)</span>
                    </div>
                    <div class="metric-progress">
                        <div class="metric-progress-bar" style="width: @(GetProgressWidth(timeToFirstByte, 500))%; background: #ffd700;"></div>
                    </div>

                    <div class="metric-item">
                        <span class="metric-label">FCP:</span>
                        <span class="metric-value timing">@Math.Round(firstContentfulPaint, 1)</span>
                    </div>
                    <div class="metric-progress">
                        <div class="metric-progress-bar" style="width: @(GetProgressWidth(firstContentfulPaint, 1800))%; background: #ffd700;"></div>
                    </div>

                    <div class="metric-item">
                        <span class="metric-label">DOM:</span>
                        <span class="metric-value timing">@Math.Round(domContentLoaded, 1)</span>
                    </div>
                    <div class="metric-progress">
                        <div class="metric-progress-bar" style="width: @(GetProgressWidth(domContentLoaded, 2000))%; background: #ffd700;"></div>
                    </div>

                    <div class="metric-item">
                        <span class="metric-label">Load:</span>
                        <span class="metric-value timing">@Math.Round(loadComplete, 1)</span>
                    </div>
                    <div class="metric-progress">
                        <div class="metric-progress-bar" style="width: @(GetProgressWidth(loadComplete, 3000))%; background: @GetTimingColor(loadComplete)"></div>
                    </div>

                    @if (largestContentfulPaint > 0)
                    {
                        <div class="metric-item">
                            <span class="metric-label">LCP:</span>
                            <span class="metric-value timing">@Math.Round(largestContentfulPaint, 1)</span>
                        </div>
                        <div class="metric-progress">
                            <div class="metric-progress-bar" style="width: @(GetProgressWidth(largestContentfulPaint, 2500))%; background: @GetTimingColor(largestContentfulPaint)"></div>
                        </div>
                    }
                </div>

                <!-- Data Transfer Metrics -->
                <div class="metric-group">
                    <div class="metric-group-title">
                        <span>📊</span>
                        <span>Data Transfer</span>
                    </div>
                    <div class="metric-item">
                        <span class="metric-label">Transfer:</span>
                        <span class="metric-value size">@transferSizeFormatted</span>
                    </div>
                    @if (transferSize > 0)
                    {
                        <div class="metric-progress">
                            <div class="metric-progress-bar" style="width: @(GetDataSizeProgress(transferSize))%; background: #00bfff;"></div>
                        </div>
                    }

                    <div class="metric-item">
                        <span class="metric-label">Encoded:</span>
                        <span class="metric-value size">@encodedSizeFormatted</span>
                    </div>
                    @if (encodedSize > 0)
                    {
                        <div class="metric-progress">
                            <div class="metric-progress-bar" style="width: @(GetDataSizeProgress(encodedSize))%; background: #00bfff;"></div>
                        </div>
                    }

                    <div class="metric-item">
                        <span class="metric-label">Decoded:</span>
                        <span class="metric-value size">@decodedSizeFormatted</span>
                    </div>
                    @if (decodedSize > 0)
                    {
                        <div class="metric-progress">
                            <div class="metric-progress-bar" style="width: @(GetDataSizeProgress(decodedSize))%; background: #00bfff;"></div>
                        </div>
                    }

                    @if (compressionRatio > 0)
                    {
                        <div class="metric-item">
                            <span class="metric-label">Compression:</span>
                            <span class="metric-value ratio">@compressionRatio%</span>
                        </div>
                        <div class="metric-progress">
                            <div class="metric-progress-bar" style="width: @compressionRatio%; background: #ff6b9d;"></div>
                        </div>
                    }
                </div>
            </div>

            <!-- Performance Breakdown -->
            @if (serverResponseTime > 0 || domProcessingTime > 0 || resourceLoadTime > 0)
            {
                <div class="performance-breakdown">
                    <div class="metric-group-title">
                        <span>🔬</span>
                        <span>Performance Breakdown</span>
                    </div>
                    <div class="breakdown-grid">
                        @if (serverResponseTime > 0)
                        {
                            <div class="breakdown-item">
                                <div class="metric-label">Server Response</div>
                                <div class="metric-value breakdown">@Math.Round(serverResponseTime, 1)ms</div>
                                <div class="metric-progress">
                                    <div class="metric-progress-bar" style="width: @(GetProgressWidth(serverResponseTime, 1000))%; background: #ff8c42;"></div>
                                </div>
                            </div>
                        }
                        @if (domProcessingTime > 0)
                        {
                            <div class="breakdown-item">
                                <div class="metric-label">DOM Processing</div>
                                <div class="metric-value breakdown">@Math.Round(domProcessingTime, 1)ms</div>
                                <div class="metric-progress">
                                    <div class="metric-progress-bar" style="width: @(GetProgressWidth(domProcessingTime, 1000))%; background: #ff8c42;"></div>
                                </div>
                            </div>
                        }
                        @if (resourceLoadTime > 0)
                        {
                            <div class="breakdown-item">
                                <div class="metric-label">Resource Load</div>
                                <div class="metric-value breakdown">@Math.Round(resourceLoadTime, 1)ms</div>
                                <div class="metric-progress">
                                    <div class="metric-progress-bar" style="width: @(GetProgressWidth(resourceLoadTime, 1000))%; background: #ff8c42;"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Performance Rating -->
            <div class="performance-rating">
                <div class="rating-badge @GetPerformanceRatingClass()">
                    <span>@GetPerformanceRatingIcon()</span>
                    <span>@GetPerformanceRating()</span>
                </div>
                @if (GetPerformanceScore() > 0)
                {
                    <div style="margin-top: 8px; font-size: 10px; color: #888;">
                        Score: @GetPerformanceScore()/100
                    </div>
                }
            </div>

            <!-- Refresh Button -->
            <div style="text-align: center; margin-top: 12px;">
                <button type="button" class="refresh-button" @onclick="RefreshMetrics" @onclick:stopPropagation="true">
                    <span>🔄</span>
                    <span>Refresh</span>
                </button>
            </div>
        </div>
    }
</div>

@code {
    private bool isHidden = false;
    private bool isCollapsed = false;
    private ElementReference speedElement;
    private string currentTime = "";

    // Timing metrics
    private double timeToFirstByte = 0;
    private double domContentLoaded = 0;
    private double loadComplete = 0;
    private double firstContentfulPaint = 0;
    private double largestContentfulPaint = 0;

    // Size metrics
    private double transferSize = 0;
    private double encodedSize = 0;
    private double decodedSize = 0;
    private string transferSizeFormatted = "0 B";
    private string encodedSizeFormatted = "0 B";
    private string decodedSizeFormatted = "0 B";

    // Calculated metrics
    private double serverResponseTime = 0;
    private double domProcessingTime = 0;
    private double resourceLoadTime = 0;
    private double compressionRatio = 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(1000);
            await UpdateMetricsAsync();
            await UpdateTimestamp();
        }
    }

    private async Task UpdateMetricsAsync()
    {
        try
        {
            var functionExists = await JS.InvokeAsync<bool>("eval", "typeof window.getPageLoadMetrics === 'function'");

            if (functionExists)
            {
                var metrics = await JS.InvokeAsync<PageLoadMetrics>("getPageLoadMetrics");
                if (metrics != null)
                {
                    timeToFirstByte = metrics.TimeToFirstByte;
                    domContentLoaded = metrics.DomContentLoaded;
                    loadComplete = metrics.LoadComplete;
                    firstContentfulPaint = metrics.FirstContentfulPaint;
                    largestContentfulPaint = metrics.LargestContentfulPaint;

                    transferSize = metrics.TransferSize;
                    encodedSize = metrics.EncodedSize;
                    decodedSize = metrics.DecodedSize;
                    transferSizeFormatted = metrics.TransferSizeFormatted;
                    encodedSizeFormatted = metrics.EncodedSizeFormatted;
                    decodedSizeFormatted = metrics.DecodedSizeFormatted;

                    serverResponseTime = metrics.ServerResponseTime;
                    domProcessingTime = metrics.DomProcessingTime;
                    resourceLoadTime = metrics.ResourceLoadTime;

                    if (decodedSize > 0 && encodedSize > 0)
                    {
                        compressionRatio = Math.Round(((decodedSize - encodedSize) / decodedSize) * 100, 1);
                    }
                }
                else
                {
                    await GetFallbackTiming();
                }
            }
            else
            {
                await GetLegacyTiming();
            }
        }
        catch (Exception)
        {
            await GetFallbackTiming();
        }
    }

    private async Task GetLegacyTiming()
    {
        try
        {
            var functionExists = await JS.InvokeAsync<bool>("eval", "typeof window.getPageLoadTimes === 'function'");

            if (functionExists)
            {
                var timings = await JS.InvokeAsync<double[]>("getPageLoadTimes");
                if (timings != null && timings.Length >= 2)
                {
                    loadComplete = Math.Round(timings[0], 1);
                    domContentLoaded = Math.Round(timings[1], 1);
                    timeToFirstByte = Math.Round(domContentLoaded * 0.3, 1);
                }
                else
                {
                    await GetFallbackTiming();
                }
            }
            else
            {
                await GetFallbackTiming();
            }
        }
        catch
        {
            await GetFallbackTiming();
        }
    }

    private async Task GetFallbackTiming()
    {
        try
        {
            var now = await JS.InvokeAsync<double>("performance.now");
            loadComplete = Math.Round(now, 1);
            domContentLoaded = Math.Round(now * 0.8, 1);
            timeToFirstByte = Math.Round(now * 0.3, 1);
            firstContentfulPaint = Math.Round(now * 0.6, 1);

            transferSizeFormatted = "Unknown";
            encodedSizeFormatted = "Unknown";
            decodedSizeFormatted = "Unknown";
        }
        catch
        {
            var estimatedTime = DateTime.Now.Millisecond + 100;
            loadComplete = estimatedTime;
            domContentLoaded = estimatedTime * 0.8;
            timeToFirstByte = estimatedTime * 0.3;
            firstContentfulPaint = estimatedTime * 0.6;

            transferSizeFormatted = "Unknown";
            encodedSizeFormatted = "Unknown";
            decodedSizeFormatted = "Unknown";
        }
    }

    private void ToggleVisibility()
    {
        isHidden = !isHidden;
    }

    private void ToggleCollapsed()
    {
        isCollapsed = !isCollapsed;
    }

    private async Task RefreshMetrics()
    {
        await UpdateMetricsAsync();
        await UpdateTimestamp();
        StateHasChanged();
    }

    private async Task UpdateTimestamp()
    {
        currentTime = DateTime.Now.ToString("HH:mm:ss");
        StateHasChanged();
    }

    private string GetPerformanceRating()
    {
        var primaryMetric = largestContentfulPaint > 0 ? largestContentfulPaint : loadComplete;

        return primaryMetric switch
        {
            <= 1000 => "EXCELLENT",
            <= 2500 => "GOOD",
            <= 4000 => "FAIR",
            _ => "POOR"
        };
    }

    private string GetPerformanceRatingClass()
    {
        var primaryMetric = largestContentfulPaint > 0 ? largestContentfulPaint : loadComplete;

        return primaryMetric switch
        {
            <= 1000 => "excellent",
            <= 2500 => "good",
            <= 4000 => "fair",
            _ => "poor"
        };
    }

    private string GetPerformanceRatingIcon()
    {
        var primaryMetric = largestContentfulPaint > 0 ? largestContentfulPaint : loadComplete;

        return primaryMetric switch
        {
            <= 1000 => "🚀",
            <= 2500 => "✅",
            <= 4000 => "⚠️",
            _ => "🐌"
        };
    }

    private int GetPerformanceScore()
    {
        var primaryMetric = largestContentfulPaint > 0 ? largestContentfulPaint : loadComplete;

        return primaryMetric switch
        {
            <= 1000 => 95,
            <= 1500 => 85,
            <= 2500 => 75,
            <= 4000 => 50,
            _ => 25
        };
    }

    private double GetProgressWidth(double value, double maxValue)
    {
        if (value <= 0 || maxValue <= 0) return 0;
        return Math.Min(100, (value / maxValue) * 100);
    }

    private double GetDataSizeProgress(double sizeBytes)
    {
        // Progress based on typical web page size (1MB = 100%)
        const double maxSize = 1024 * 1024; // 1MB
        return Math.Min(100, (sizeBytes / maxSize) * 100);
    }

    private string GetTimingColor(double timing)
    {
        return timing switch
        {
            <= 1000 => "#00ff41",
            <= 2500 => "#ffd700",
            <= 4000 => "#ff8c42",
            _ => "#ff4757"
        };
    }

    // Data model for JavaScript interop
    public class PageLoadMetrics
    {
        public double TimeToFirstByte { get; set; }
        public double DomContentLoaded { get; set; }
        public double LoadComplete { get; set; }
        public double FirstContentfulPaint { get; set; }
        public double LargestContentfulPaint { get; set; }

        public double TransferSize { get; set; }
        public double EncodedSize { get; set; }
        public double DecodedSize { get; set; }
        public string TransferSizeFormatted { get; set; } = "";
        public string EncodedSizeFormatted { get; set; } = "";
        public string DecodedSizeFormatted { get; set; } = "";

        public double ServerResponseTime { get; set; }
        public double DomProcessingTime { get; set; }
        public double ResourceLoadTime { get; set; }
    }
}
