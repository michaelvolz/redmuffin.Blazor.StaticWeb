@page "/videos"
@using redmuffin.Blazor.StaticWeb.Features.Common.Components

<PageTitle>Programming & AI Video Hub</PageTitle>

<h1>Programming & AI Video Hub</h1>
<p class="subheader">This page showcases a curated collection of videos on programming, AI, .NET, C#, Blazor, and more, featuring insights from industry experts and practical tutorials.</p>

<RefreshBadge State="_context.BadgeState" OnClick="HandleRefreshClickAsync"/>

@if (!string.IsNullOrEmpty(_context.ErrorMessage))
{
    <div class="callout alert">
        <p>@_context.ErrorMessage</p>
    </div>
}

<RaindropItemList Items="@_context.Items"
                  ImageUrlCache="@_context.ImageUrlCache"
                  CardCssClass="video-card"
                  ImageAlt="Video Cover"
                  LinkButtonText="Watch Video"
                  LinkButtonIcon="fa-play"
                  EmptyMessage="No videos available."/>