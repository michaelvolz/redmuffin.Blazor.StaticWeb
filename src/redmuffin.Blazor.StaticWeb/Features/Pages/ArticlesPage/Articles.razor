@page "/articles"
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using redmuffin.Blazor.StaticWeb.Features.Cache.Components
@using redmuffin.Blazor.StaticWeb.Features.Common.Components

<PageTitle>Programming & AI Article Hub</PageTitle>

<h1>Programming & AI Article Hub</h1>
<p class="subheader">This page showcases a curated collection of articles on programming, AI, .NET, C#, Blazor, and more, featuring insights from industry experts and practical tutorials.</p>

<RefreshBadge State="_refreshBadgeState" OnClick="HandleRefreshClickAsync"/>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="callout alert">
        <p>@_errorMessage</p>
    </div>
}

@if (_isLoading)
{
    <p>Loading articles...</p>
}
else if (_articleItems != null && _articleItems.Any())
{
    <div class="masonry">
        <Virtualize Items="@_articleItems" Context="article" ItemSize="400" OverscanCount="3">
            <ItemContent>
                <RaindropItemCard Item="@article"
                                  ItemType="article"
                                  Index="@_articleItems.IndexOf(article)"
                                  ImageUrlCache="@_imageUrlCache"
                                  ImagePlaceholderService="@ImagePlaceholderService"
                                  JsRuntime="@Js"
                                  OnImageLoad="@HandleCardImageLoadAsync" />
            </ItemContent>
            <Placeholder>
                <div class="card article-card">
                    <div class="shimmer-placeholder" style="height: 350px;">
                        <div class="shimmer"></div>
                    </div>
                </div>
            </Placeholder>
        </Virtualize>
    </div>
}
else
{
    <p>No articles available.</p>
}
