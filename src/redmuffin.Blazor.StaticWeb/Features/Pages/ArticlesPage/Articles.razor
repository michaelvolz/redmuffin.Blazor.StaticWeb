@page "/articles"
@inject HttpClient Http

<PageTitle>Programming & AI Article Hub</PageTitle>

<h1>Programming & AI Article Hub</h1>
<p class="subheader">This page showcases a curated collection of articles on programming, AI, .NET, C#, Blazor, and more, featuring insights from industry experts and practical tutorials.</p>

@if (_isLoading)
{
    <p>Loading articles...</p>
}
else if (_articleItems != null && _articleItems.Any())
{
    <div class="masonry">
        @foreach (var article in _articleItems)
        {
            var processingState = GetImageProcessingState(article);
            var imageUrl = _imageUrlCache.ContainsKey(article.Link) ? _imageUrlCache[article.Link] : "data:image/svg+xml;base64,";

            <div class="card article-card @GetCardStateClass(processingState)">
                <div class="card-divider">
                    <h5>@DisplayTitle(article)</h5>
                </div>
                <div class="shimmer-placeholder @(processingState == "processing" ? "processing" : "")" id="shimmer-@article.Id">
                    <img src="@imageUrl" alt="Article Cover" @onload="@(() => HandleImageLoadAsync($"shimmer-{article.Id}", article.Link, true))" @onerror="@(() => HandleImageLoadAsync($"shimmer-{article.Id}", article.Link, false))"/>
                    @if (HasFallbackPlaceholder(article))
                    {
                        <div class="fallback-placeholder-overlay">
                            <i class="fas fa-image"></i>
                            <span>@GetFallbackReason(article)</span>
                        </div>
                    }
                </div>
                <div class="card-section">
                    <p>@DisplayExcerpt(article)</p>
                    <p><i class="fas fa-calendar-alt"></i> Created: @article.Created.ToString("yyyy-MM-dd")</p>
                    <a href="@article.Link" target="_blank" class="button"><i class="fas fa-external-link-alt"></i> Read Article</a>
                </div>
            </div>
        }
    </div>
}
else if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="callout alert">
        <p>@_errorMessage</p>
    </div>
}