@page "/videos"
@inject HttpClient Http

<PageTitle>Programming & AI Video Hub</PageTitle>

<h1>Programming & AI Video Hub</h1>
<p class="subheader">This page showcases a curated collection of videos on programming, AI, .NET, C#, Blazor, and more, featuring insights from industry experts and practical tutorials.</p>

<button class="button primary" @onclick="LoginWithRaindropAsync">
    <i class="fas fa-sign-in-alt"></i> Login with Raindrop.io
</button>
<button class="button primary" @onclick="FetchVideosAsync">
    <i class="fas fa-video"></i> Fetch Videos
</button>

@if (_videoItems != null && _videoItems.Any())
{
    <div class="masonry">
        @foreach (var video in _videoItems)
        {
            <div class="card video-card">
                <div class="card-divider">
                    <h5>@(string.IsNullOrEmpty(video.Title) ? "No Title Available" : video.Title)</h5>
                </div>
                <div class="shimmer-placeholder" id="shimmer-@video.Id">
                    <img src="@video.Cover" alt="Video Cover" @onload="@(() => StopShimmerAsync($"shimmer-{video.Id}"))" @onerror="@(() => StopShimmerAsync($"shimmer-{video.Id}"))" />
                </div>
                <div class="card-section">
                    <p>@(string.IsNullOrEmpty(video.Excerpt) ? "No Excerpt Available" : video.Excerpt.Length > 250 ? video.Excerpt.Substring(0, 250) + "..." : video.Excerpt)</p>
                    <p><i class="fas fa-calendar-alt"></i> Created: @video.Created.ToString("yyyy-MM-dd")</p>
                    <a href="@video.Link" target="_blank" class="button"><i class="fas fa-play"></i> Watch Video</a>
                </div>
            </div>
        }
    </div>
}
else if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="callout alert">
        <p>@_errorMessage</p>
    </div>
}