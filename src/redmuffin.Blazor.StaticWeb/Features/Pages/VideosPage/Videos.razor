@page "/videos"
@using redmuffin.Blazor.StaticWeb.Features.Cache.Components

<PageTitle>Programming & AI Video Hub</PageTitle>

<h1>Programming & AI Video Hub</h1>
<p class="subheader">This page showcases a curated collection of videos on programming, AI, .NET, C#, Blazor, and more, featuring insights from industry experts and practical tutorials.</p>

<RefreshBadge State="_refreshBadgeState" OnClick="HandleRefreshClickAsync"/>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="callout alert">
        <p>@_errorMessage</p>
    </div>
}

@if (_videoItems != null && _videoItems.Any())
{
    <div class="masonry">
        @foreach (var (video, index) in _videoItems.Select((v, i) => (v, i)))
        {
            <div class="card video-card">
                <div class="card-divider">
                    <h5>@DisplayTitle(video)</h5>
                </div>
                <div class="shimmer-placeholder" id="shimmer-@video.Id">
                    <img src="@GetImageUrl(video)" alt="Video Cover"
                         loading="@(index < 6 ? "eager" : "lazy")"
                         fetchpriority="@(index < 6 ? "high" : "low")"
                         decoding="async"
                          @onload="@(() => HandleImageLoadAsync($"shimmer-{video.Id}", video.Link ?? video.Id.ToString(), true))"
                                                   @onerror="@(() => HandleImageLoadAsync($"shimmer-{video.Id}", video.Link ?? video.Id.ToString(), false))"/>
                    @if (HasFallbackPlaceholder(video))
                    {
                        <div class="fallback-placeholder-overlay">
                            <i class="fas fa-image"></i>
                            <span>@GetFallbackReason(video)</span>
                        </div>
                    }
                </div>
                <div class="card-section">
                    <p>@DisplayExcerpt(video)</p>
                    <p><i class="fas fa-calendar-alt"></i> Created: @video.Created.ToString("yyyy-MM-dd")</p>
                    <a href="@video.Link" target="_blank" class="button"><i class="fas fa-play"></i> Watch Video</a>
                </div>
            </div>
        }
    </div>
}
else
{
    <p>No videos available.</p>
}