@page "/videos"
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using redmuffin.Blazor.StaticWeb.Features.Cache.Components
@using redmuffin.Blazor.StaticWeb.Features.Common.Components

<PageTitle>Programming & AI Video Hub</PageTitle>

<h1>Programming & AI Video Hub</h1>
<p class="subheader">This page showcases a curated collection of videos on programming, AI, .NET, C#, Blazor, and more, featuring insights from industry experts and practical tutorials.</p>

<RefreshBadge State="_refreshBadgeState" OnClick="HandleRefreshClickAsync"/>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="callout alert">
        <p>@_errorMessage</p>
    </div>
}

@if (_videoItems != null && _videoItems.Any())
{
    <div class="masonry">
        <Virtualize Items="@_videoItems" Context="video" ItemSize="400" OverscanCount="3">
            <ItemContent>
                <RaindropItemCard Item="@video"
                                  ItemType="video"
                                  Index="@_videoItems.IndexOf(video)"
                                  ImageUrlCache="@_imageUrlCache"
                                  ImagePlaceholderService="@ImagePlaceholderService"
                                  JsRuntime="@Js"
                                  OnImageLoad="@HandleCardImageLoadAsync" />
            </ItemContent>
            <Placeholder>
                <div class="card video-card">
                    <div class="shimmer-placeholder" style="height: 350px;">
                        <div class="shimmer"></div>
                    </div>
                </div>
            </Placeholder>
        </Virtualize>
    </div>
}
else
{
    <p>No videos available.</p>
}
