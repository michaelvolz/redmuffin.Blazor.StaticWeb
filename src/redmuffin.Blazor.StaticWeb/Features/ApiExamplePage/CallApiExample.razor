@page "/call-api-example"

<PageTitle>Call API Example</PageTitle>

<h1>Call API Example</h1>

<button class="button" @onclick="CallApiAsync">Call Hello World API</button>

@if (!string.IsNullOrEmpty(_apiResponse))
{
    <p>
        <strong>API Response:</strong> @_apiResponse
    </p>
}
@if (!string.IsNullOrEmpty(_errorMessage))
{
    <p style="color: red;">
        <strong>Error:</strong> @_errorMessage
    </p>
}