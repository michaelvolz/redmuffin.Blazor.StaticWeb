@page "/articles"
@using redmuffin.Blazor.StaticWeb.Features.Common.Components

<PageTitle>Programming & AI Article Hub</PageTitle>

<HeadContent>
    <meta name="description" content="Curated collection of programming, AI, .NET, C#, and Blazor articles featuring insights from industry experts and practical tutorials." />
</HeadContent>

<h3>Programming &amp; AI Article Hub</h3>
<p class="subheader">This page showcases a curated collection of articles on programming, AI, .NET, C#, Blazor, and more, featuring insights from industry experts and practical tutorials.</p>

@if (_context.BadgeState != RefreshBadgeState.Hidden)
{
    <RefreshBadge State="_context.BadgeState" OnClick="HandleRefreshClickAsync"/>
}

@if (!string.IsNullOrEmpty(_context.ErrorMessage))
{
    <div class="callout alert" role="alert">
        <p>@_context.ErrorMessage</p>
    </div>
}

<RaindropItemList Items="@_context.Items"
                  ImageUrlCache="@_context.ImageUrlCache"
                  CardCssClass="article-card"
                  ImageAlt="Article Cover"
                  LinkButtonText="Read Article"
                  LinkButtonIcon="fa-external-link-alt"
                  EmptyMessage="No articles available."/>