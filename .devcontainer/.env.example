# DevContainer Environment Variables - DOCUMENTATION ONLY
# ====================================================
#
# WARNING: This file is for REFERENCE ONLY.
# DO NOT put actual secrets in this file or any .env file.
#
# This project uses VS Code DevContainer Secrets instead.
# Secrets are stored in your OS credential manager and injected
# at container runtime - they never touch disk.
#
# To configure secrets:
# 1. Open the project in VS Code with Remote - Containers extension
# 2. VS Code will prompt for secrets on first container start
# 3. Or manually: Command Palette → "Dev Containers: Configure Secrets"
#
# See .devcontainer/SECURITY.md for full details.

# Required secrets (defined in devcontainer.json):

# Brave Search API Key
# Get at: https://brave.com/search/api/
BRAVE_API_KEY=

# Context7 API Key (optional, for up-to-date library documentation)
# Get at: https://context7.com
CONTEXT7_API_KEY=

# Raindrop.io OAuth Credentials (for local development)
# Get at: https://app.raindrop.io/settings/integrations/developer
RAINDROP_CLIENT_ID=
RAINDROP_CLIENT_SECRET=
