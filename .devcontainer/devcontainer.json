{
  "name": "${localWorkspaceFolderBasename} (Isolated)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceMount": "source=${localWorkspaceFolderBasename}-workspace,target=/workspaces/${localWorkspaceFolderBasename},type=volume",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts",
      "installTools": false
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true
    },
    "ghcr.io/devcontainers/features/powershell:1": {
      "version": "latest"
    }
  },
  "forwardPorts": [4280, 5233, 7071],
  "portsAttributes": {
    "4280": {
      "label": "Azure Static Web Apps",
      "onAutoForward": "openPreview"
    },
    "5233": {
      "label": "Blazor WebAssembly",
      "onAutoForward": "openPreview"
    },
    "7071": {
      "label": "Azure Functions",
      "onAutoForward": "silent"
    }
  },
  "mounts": [
    "source=${localEnv:USERPROFILE}/.ssh,target=/mnt/host-ssh,type=bind,readonly",
    "source=${localWorkspaceFolderBasename}-cache,target=/root/.cache,type=volume",
    "source=${localWorkspaceFolderBasename}-npm,target=/root/.npm,type=volume",
    "source=${localWorkspaceFolderBasename}-nuget,target=/root/.nuget,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh 2>/dev/null || true",
  "customizations": {
    "vscode": {
      "settings": {
        "dotnet.defaultSolution": "redmuffin.Blazor.StaticWeb.sln",
        "dotnet.debugger.launchJsonSchemaVersion": "1.0.0",
        "dotnet.server.waitForDebugger": false,
        "dotnet.tests.useUtmps": true,
        "azureFunctions.projectSubpath": "src/redmuffin.Blazor.StaticWeb.Api",
        "azureFunctions.deploySubpath": "src/redmuffin.Blazor.StaticWeb.Api/bin/Release/net9.0/publish",
        "azureFunctions.projectLanguage": "C#",
        "azureFunctions.projectRuntime": "~4",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll": "explicit",
          "source.organizeImports": "explicit"
        },
        "files.trimTrailingWhitespace": true,
        "blazorwasm.trace": "verbose",
        "security.workspace.trust.enabled": true,
        "security.workspace.trust.startupPrompt": "never"
      },
      "extensions": [
        "ms-vscode-remote.remote-containers",
        "ms-azuretools.vscode-azurefunctions",
        "ms-azuretools.vscode-azurestaticwebapps",
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.blazorwasm-companion",
        "ms-dotnettools.dotnet-test-explorer",
        "editorconfig.editorconfig",
        "streetsidesoftware.code-spell-checker",
        "davidanson.vscode-markdownlint",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "remoteEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1",
    "NPM_CONFIG_UPDATE_NOTIFIER": "false",
    "GIT_CLONE_URL": "git@github.com:michaelvolz/redmuffin.Blazor.StaticWeb.git",
    "BRAVE_API_KEY": "${localEnv:BRAVE_API_KEY}",
    "CONTEXT7_API_KEY": "${localEnv:CONTEXT7_API_KEY}",
    "RainDropClientID": "${localEnv:RainDropClientID}",
    "RainDropClientSecret": "${localEnv:RainDropClientSecret}",
    "RainDropTestToken": "${localEnv:RainDropTestToken}"
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1",
    "NPM_CONFIG_UPDATE_NOTIFIER": "false"
  },
  "containerUser": "vscode",
  "securityOpt": ["seccomp=unconfined"],
  "privileged": true
}
