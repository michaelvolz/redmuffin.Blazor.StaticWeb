{
  "inputs": [
    {
      "type": "promptString",
      "id": "github_token",
      "description": "GitHub Personal Access Token",
      "password": true
    }
  ],
  "servers": {
    "github": {
      "command": "docker",
      "args": [ "run", "-i", "--rm", "mcp/github" ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${input:github_token}"
      }
    },
    "fetch": {
      "command": "docker",
      "args": [ "run", "-i", "--rm", "mcp/fetch" ]
    },
    "time": {
      "command": "docker",
      "args": [ "run", "-i", "--rm", "mcp/time" ]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    }
  }
}